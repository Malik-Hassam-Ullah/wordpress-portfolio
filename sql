base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:8:\"Bob Dunn\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:21;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:65:\"Open Channels FM: The Core Principles of the Open Web, Simplified\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2563857\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:60:\"https://openchannels.fm/the-core-principles-of-the-open-web/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:214:\"The open web is defined by five principles: open standards, permissionless publishing, linking, interoperability, and decentralization, ensuring freedom, flexibility, and user control in online information sharing.\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Mon, 02 Nov 2026 12:28:00 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:16:\"Open Channels FM\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:22;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:58:\"WordCamp Central: WordCamp Sylhet 2026: No Swag, All Heart\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:40:\"https://central.wordcamp.org/?p=16593983\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:81:\"https://central.wordcamp.org/news/2026/11/wordcamp-sylhet-2026-no-swag-all-heart/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:11167:\"<p class=\"wp-block-paragraph\">What happens when you take the swag out of a WordCamp? You get more of what WordCamps were always about: people, ideas, and real conversations.</p>\n\n\n\n<p class=\"wp-block-paragraph\">On October 2 and 3, 2026, the WordPress community gathered at the Central Auditorium of Shahjalal University of Science and Technology (SUST) for WordCamp Sylhet 2026. This year the organizers made a bold call: no swag from the organizers and no swag from the sponsors. I was there for both days as an organizer, and it turned out to be one of the best WordCamp experiences I&#8217;ve had.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/PROX9652-scaled.jpg\"><img alt=\"\" class=\"wp-image-16648810\" height=\"683\" src=\"https://central.wordcamp.org/files/2026/11/PROX9652-1024x683.jpg\" width=\"1024\" /></a></figure>\n\n\n\n<h2 class=\"wp-block-heading\">Third Time in the Tea Capital</h2>\n\n\n\n<p class=\"wp-block-paragraph\">WordCamp Sylhet first came to the city in May 2023 and returned in 2024. The 2026 edition was its third, back at the same SUST auditorium where it all started.</p>\n\n\n\n<p class=\"wp-block-paragraph\">This time the organizing team chose a clear theme: back to basics. Their message from the very first announcement was &#8220;less show, more substance.&#8221; As WordCamps grow, the focus can drift toward production, merchandise, and presentation. Sylhet wanted to bring the spotlight back to knowledge, genuine conversations, and community connections.</p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<h2 class=\"wp-block-heading\">What a Swag-Free WordCamp Feels Like</h2>\n\n\n\n<p class=\"wp-block-paragraph\">I&#8217;ll admit I was curious. Swag is part of the WordCamp ritual: the T-shirts, stickers, notebooks, and the queue at every booth. How would an event feel without it?</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/PROX9655-scaled.jpg\"><img alt=\"\" class=\"wp-image-16648826\" height=\"683\" src=\"https://central.wordcamp.org/files/2026/11/PROX9655-1024x683.jpg\" width=\"1024\" /></a></figure>\n\n\n\n<p class=\"wp-block-paragraph\">The answer: lighter, warmer, and more focused. Nobody was rushing from table to table collecting goodies. Instead, people stopped and talked. Hallway chats ran longer. Lunch tables turned into mini-meetups. Questions after sessions were sharper because people came for the content.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Swag bags get forgotten in a drawer. A five-minute conversation with the right person can turn into a client, a job, or a friendship. WordCamp Sylhet 2026 proved that the community itself is the best takeaway.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/PROX0491-scaled.jpg\"><img alt=\"\" class=\"wp-image-16648812\" height=\"683\" src=\"https://central.wordcamp.org/files/2026/11/PROX0491-1024x683.jpg\" width=\"1024\" /></a></figure>\n\n\n\n<h2 class=\"wp-block-heading\">Day One: Contributor Day</h2>\n\n\n\n<p class=\"wp-block-paragraph\">October 2 was Contributor Day, and around 150 people sat down at the contributor tables to give back to WordPress. The work ranged from bug fixes in Core to new designs for the Patterns Team.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/829633909_1020752920993815_7895854680051380933_n.jpg\"><img alt=\"\" class=\"wp-image-16648813\" height=\"768\" src=\"https://central.wordcamp.org/files/2026/11/829633909_1020752920993815_7895854680051380933_n-1024x768.jpg\" width=\"1024\" /></a></figure>\n\n\n\n<p class=\"wp-block-paragraph\">What I love about Contributor Day is that you don&#8217;t need to be a senior developer to take part. Whether you code, write, design, translate, or test, there is a table for you. For many first-timers, it was the day they made their first contribution to one of the world&#8217;s largest open-source projects, shoulder to shoulder with the people who build it.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/WhatsApp-Image-2026-11-01-at-21.10.45.jpeg\"><img alt=\"\" class=\"wp-image-16648825\" height=\"682\" src=\"https://central.wordcamp.org/files/2026/11/WhatsApp-Image-2026-11-01-at-21.10.45-1024x682.jpeg\" width=\"1024\" /></a></figure>\n\n\n\n<h2 class=\"wp-block-heading\">Day Two: Conference Day and the Rise of AI</h2>\n\n\n\n<p class=\"wp-block-paragraph\">October 3 was Conference Day, packed with talks and panel discussions from morning to evening. With the swag gone, the sessions really were the heart of the event.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If one topic ran through the whole schedule, it was AI. A few sessions that stood out:</p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Panel: How AI Is Reshaping Modern Workflows.</strong> M Asif Rahman, MD Ershadur Rahman Talukder, and Shahjahan Jewel shared practical lessons on how AI is changing the way WordPress teams plan, build, and ship.</li>\n\n\n\n<li><strong>From Plugins to Agents.</strong> Nazmul Hasan Rupok explored how WordPress architecture is shifting as AI agents arrive, including using the WordPress Abilities API so any MCP client can use a plugin&#8217;s features.</li>\n\n\n\n<li><strong>Customer Support, Reimagined.</strong> Khan Rafin Ahmed showed how AI agents and the Model Context Protocol (MCP) help support teams do more.</li>\n\n\n\n<li><strong>Find It, Fix It, Prove It.</strong> Niluthpal Purkayastha talked about using AI to find and fix security holes in WordPress plugins.</li>\n</ul>\n\n\n\n<p class=\"wp-block-paragraph\">The common message: AI isn&#8217;t replacing the WordPress community. It&#8217;s giving builders new tools, and Bangladesh&#8217;s developers are already putting them to work.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/IMG_6882-scaled.jpg\"><img alt=\"\" class=\"wp-image-16648814\" height=\"768\" src=\"https://central.wordcamp.org/files/2026/11/IMG_6882-1024x768.jpg\" width=\"1024\" /></a></figure>\n\n\n\n<h2 class=\"wp-block-heading\">Sponsors Without Swag: Real Conversations at the Booths</h2>\n\n\n\n<p class=\"wp-block-paragraph\">No swag didn&#8217;t mean no sponsors. Companies still had booths in the expo area, and they still had a great chance to show what they&#8217;re building. The difference was the quality of the conversations.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Instead of handing out freebies, sponsor teams explained their products, heard feedback from users and met new people who were genuinely interested. Some booths ran friendly challenges and contests that broke the ice and started long chats.</p>\n\n\n\n<p class=\"wp-block-paragraph\">For businesses, that&#8217;s arguably worth more than a thousand tote bags. And it matters for the community too: WordCamps are nonprofit and volunteer-run, and sponsorship keeps tickets affordable for students, freelancers and first-timers.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/PROX1825-scaled.jpg\"><img alt=\"\" class=\"wp-image-16648815\" height=\"683\" src=\"https://central.wordcamp.org/files/2026/11/PROX1825-1024x683.jpg\" width=\"1024\" /></a></figure>\n\n\n\n<h2 class=\"wp-block-heading\">The Energy: A Community That Showed Up</h2>\n\n\n\n<p class=\"wp-block-paragraph\">The most crucial part of WordCamp Sylhet 2026 wasn&#8217;t on the schedule. It was the energy.</p>\n\n\n\n<p class=\"wp-block-paragraph\">From the first Contributor Day table to the final session, the auditorium stayed full of enthusiasm. Students, developers, designers, freelancers, agency owners, and product teams came from across Bangladesh. Everyone was eager to learn, share, and connect, and you could feel it in every room and every hallway.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/PROX1851-scaled.jpg\"><img alt=\"\" class=\"wp-image-16648828\" height=\"683\" src=\"https://central.wordcamp.org/files/2026/11/PROX1851-1024x683.jpg\" width=\"1024\" /></a></figure>\n\n\n\n<p class=\"wp-block-paragraph\">The green SUST campus, a short ride from Sylhet&#8217;s famous tea gardens, gave the whole event a calm and welcoming feel. It&#8217;s hard to imagine a better home for a community gathering.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/PROX9743-scaled.jpg\"><img alt=\"\" class=\"wp-image-16648817\" height=\"683\" src=\"https://central.wordcamp.org/files/2026/11/PROX9743-1024x683.jpg\" width=\"1024\" /></a></figure>\n\n\n\n<h2 class=\"wp-block-heading\">Thank you, Sylhet.</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Organizing a two-day event for a community this size is never easy, and no event runs perfectly. What stays with you is the effort and heart behind it, and there was plenty of both.</p>\n\n\n\n<p class=\"wp-block-paragraph\">A huge thank you to the organizers and volunteers who made it happen, the speakers who shared their knowledge, the sponsors who supported the event and showed up for real conversations, and every attendee who brought their energy.</p>\n\n\n\n<p class=\"wp-block-paragraph\">WordCamp Sylhet 2026 showed that you don&#8217;t need freebies to make an event memorable. You need people who care. Back to basics turned out to be exactly what we needed.<br /><br /><img alt=\"🙏\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f64f.png\" style=\"height: 1em;\" /> <strong>A big thank you to the sponsors of WordCamp Sylhet 2026!</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">WordCamp Sylhet 2026 brought together WordPress enthusiasts, developers, designers, and community members at Shahjalal University of Science and Technology. It was possible because these organizations believed in our community and supported open source in Bangladesh.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><img alt=\"💎\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f48e.png\" style=\"height: 1em;\" /> <strong>Platinum Sponsors</strong><br />Automattic • Bluehost • FluentCart • FlyWP • Hostinger • Kirki • OneSuite • WooCommerce • xCloud</p>\n\n\n\n<p class=\"wp-block-paragraph\"><img alt=\"🥈\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f948.png\" style=\"height: 1em;\" /> <strong>Silver Sponsors</strong><br />Bit CRM • bPlugins</p>\n\n\n\n<p class=\"wp-block-paragraph\"><img alt=\"🥉\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f949.png\" style=\"height: 1em;\" /> <strong>Bronze Sponsors</strong><br />PaymentForm.io • SubscriptionPro • Timetics AI • WebAppick</p>\n\n\n\n<p class=\"wp-block-paragraph\">Thanks also to our micro sponsors and to every organizer, volunteer, speaker, and attendee who helped make it happen. <img alt=\"❤\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/2764.png\" style=\"height: 1em;\" /></p>\n\n\n\n<p class=\"wp-block-paragraph\">See you at the next WordCamp!</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><a href=\"https://central.wordcamp.org/files/2026/11/PROX2018-1-scaled.jpg\"><img alt=\"\" class=\"wp-image-16648816\" height=\"682\" src=\"https://central.wordcamp.org/files/2026/11/PROX2018-1-1024x682.jpg\" width=\"1024\" /></a></figure>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Sun, 01 Nov 2026 15:04:39 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:12:\"Nazmul Hosen\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:23;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:138:\"WordCamp Central: WordPress Campus Connect at Presidency University: Building Skills, Exploring Careers, and Inspiring the Next Generation\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:40:\"https://central.wordcamp.org/?p=16625654\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:160:\"https://central.wordcamp.org/news/2026/10/wordpress-campus-connect-at-presidency-university-building-skills-exploring-careers-and-inspiring-the-next-generation/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:10330:\"<p class=\"wp-block-paragraph\">We’re excited to share that <strong>WordPress <a href=\"https://events.wordpress.org/campusconnect/2026/presidency-university-dhaka/\" rel=\"noopener\" target=\"_blank\">Campus Connect at Presidency University</a>, Dhaka, has successfully concluded!</strong> <img alt=\"🎉\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f389.png\" style=\"height: 1em;\" /></p>\n\n\n\n<p class=\"wp-block-paragraph\">Held on <strong>25–26 October 2026</strong>, this two-day initiative brought students closer to WordPress, practical website development, career opportunities, and the growing role of open-source education.</p>\n\n\n\n<div class=\"wp-block-jetpack-tiled-gallery aligncenter is-style-rectangular\"><div class=\"\"><div class=\"tiled-gallery__gallery\"><div class=\"tiled-gallery__row\"><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09292-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09297-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09322-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div></div><div class=\"tiled-gallery__row\"><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09352-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09389-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09405-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div></div><div class=\"tiled-gallery__row\"><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09450-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09459-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09456-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div></div><div class=\"tiled-gallery__row\"><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09551-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09612-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div></div><div class=\"tiled-gallery__row\"><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09678-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09692-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09704-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div></div><div class=\"tiled-gallery__row\"><div class=\"tiled-gallery__col\"><figure class=\"tiled-gallery__item\"><img alt=\"\" src=\"https://i0.wp.com/central.wordcamp.org/files/2026/10/DSC09710-1024x683.jpg?ssl=1\" tabindex=\"0\" /></figure></div></div></div></div></div>\n\n\n\n<p class=\"wp-block-paragraph\">Want to see more photos from WordPress Campus Connect at Presidency University?</p>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"> <img alt=\"📸\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f4f8.png\" style=\"height: 1em;\" /> Explore all the event photos here: <a href=\"https://drive.google.com/drive/folders/1aUaiC4XXShI2426W-4JW_zaBx5xf8ekv?usp=sharing\" rel=\"noopener\" target=\"_blank\">Official Event Photos</a>  <img alt=\"📸\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f4f8.png\" style=\"height: 1em;\" /></p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Day 1: From Ideas to Websites</strong></h3>\n\n\n\n<p class=\"wp-block-paragraph\">On 25 October, we hosted a hands-on workshop where students explored WordPress by building their own websites. Together, we created <strong>50 websites and WordPress.org profiles</strong>, giving students a starting point to continue learning, experimenting, and engaging with the global WordPress community.</p>\n\n\n\n<p class=\"wp-block-paragraph\">The goal was not just to introduce a tool, but to help students take their first practical steps toward building something of their own.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Few websites created by our students:</p>\n\n\n\n<ol class=\"wp-block-list\">\n<li><a href=\"https://noyonhossain.blog/\">https://noyonhossain.blog/</a></li>\n\n\n\n<li><a href=\"https://hurayra.art/\">https://hurayra.art/</a></li>\n\n\n\n<li><a href=\"https://www.golammonayem.com/\">https://www.golammonayem.com/</a></li>\n\n\n\n<li><a href=\"https://tayenhossainshuvo.blog/\">https://tayenhossainshuvo.blog/</a></li>\n\n\n\n<li><a href=\"https://ifatkhalilfahim.blog/\">https://ifatkhalilfahim.blog/</a></li>\n\n\n\n<li><a href=\"https://r-if-a.blog/\">https://r-if-a.blog/</a></li>\n\n\n\n<li><a href=\"https://rafid.blog/\">https://rafid.blog/</a></li>\n\n\n\n<li><a href=\"https://sanjidaaktersuborna.blog/\">https://sanjidaaktersuborna.blog/</a></li>\n\n\n\n<li><a href=\"https://byapon.art/\">https://byapon.art/</a></li>\n\n\n\n<li><a href=\"https://golammonayem.blog/\">https://golammonayem.blog/</a></li>\n\n\n\n<li><a href=\"https://belalhosenbadon.blog/\">https://belalhosenbadon.blog/</a></li>\n</ol>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Day 2: Exploring Careers and WordPress Education</strong></h3>\n\n\n\n<p class=\"wp-block-paragraph\">On 26 October, we shifted our focus to career guidance and educational opportunities. We discussed how students can develop practical skills, build a portfolio, contribute to open source, and explore career pathways in the WordPress ecosystem.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Through these conversations, we encouraged students to look beyond traditional academic learning and explore how real-world projects, community participation, and continuous learning can help them prepare for their future careers.</p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Exploring WordPress Credits: Connecting Education with Real-World Experience</strong></h3>\n\n\n\n<p class=\"wp-block-paragraph\">An important part of the discussion was the <strong>WordPress Credits program</strong>, which offers universities an opportunity to connect academic learning with practical contributions to the WordPress open-source project.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We introduced the program as a potential pathway for students to go beyond learning WordPress and start contributing to a global project used by millions of people. Through structured learning, mentorship, and practical contribution opportunities, students can develop technical and collaborative skills while gaining experience in an international open-source community.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We were delighted by the university&#8217;s interest in this opportunity. <strong>Presidency University has already applied to join the WordPress Credits program</strong>, marking an encouraging step toward bringing WordPress education and contribution-based learning into its academic environment.</p>\n\n\n\n<p class=\"wp-block-paragraph\">This is an exciting opportunity to explore how students can apply their classroom knowledge to real-world projects, collaborate with the global WordPress community, and build a stronger foundation for their professional journeys.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We hope this initial engagement will lead to further collaboration between the university and the WordPress community, creating more opportunities for students to learn, contribute, and grow.</p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Supported by the Global WordPress Community</strong></h3>\n\n\n\n<p class=\"wp-block-paragraph\">This initiative was made possible with support from the global WordPress community and its sponsors, who continue to invest in education and the next generation of talent.</p>\n\n\n\n<p class=\"wp-block-paragraph\">A special thank you to <strong><a href=\"https://kirki.com/\" rel=\"noopener\" target=\"_blank\">Kirki</a> for joining as our Gold Sponsor</strong> and supporting this educational initiative. Your support helps create meaningful opportunities for students to learn, build, and explore their future in the digital world.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We’re also grateful to the university, our speakers, volunteers, and everyone who contributed their time and energy to make these two days meaningful.<br /></p>\n\n\n\n<h2 class=\"wp-block-heading\">Organisers and Speakers</h2>\n\n\n\n<p class=\"wp-block-paragraph\">The success of WordPress Campus Connect at Presidency University was made possible by the dedication and collaboration of our organizing team: Mostofa Kamal Sagor, Muhibul Haque, Nasim Miah, and Rashed Hossain.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Our speakers <strong>Nasim Miah, Nazmul Asif, Pranto Dev, Mostofa Kamal Sagor and Muhibul Haque</strong> shared valuable insights on WordPress, web design, career opportunities, NLP, and prompt engineering. Through practical guidance and engaging discussions, they helped students explore new skills, understand the evolving tech industry, and discover opportunities in the WordPress and AI era. A big thank you to all our speakers for sharing their knowledge and inspiring the next generation!</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>The journey continues. Let’s keep building opportunities for the next generation through WordPress education!</strong> <img alt=\"🚀\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f680.png\" style=\"height: 1em;\" /></p>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Fri, 30 Oct 2026 14:42:22 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:13:\"Muhibul Haque\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:24;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:78:\"Open Channels FM: Who Controls Our Software, Open Channels News Week in Review\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2565779\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:84:\"https://openchannels.fm/who-controls-our-softwa