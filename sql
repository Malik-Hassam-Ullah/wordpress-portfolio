s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:78:\"Open Channels FM: Post Formats, Bring Back the Fun and Flexibility in Blogging\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2565637\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:84:\"https://openchannels.fm/post-formats-bring-back-the-fun-and-flexibility-in-blogging/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:134:\"Bob Dunn and Derek Hanson reflect on blogging, personal writing, and using post formats to shape digital presence beyond social media.\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Thu, 29 Oct 2026 10:33:32 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:8:\"Bob Dunn\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:28;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:35:\"WordPress.org blog: WordPress 7.1.4\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:35:\"https://wordpress.org/news/?p=21896\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:51:\"https://wordpress.org/news/2026/10/wordpress-7-1-4/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:5918:\"<p class=\"wp-block-paragraph\">This security release features fixes for multiple issues.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Because this is a security release, it is recommended that you update your sites immediately.</strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">You can <a href=\"https://wordpress.org/download/\">download WordPress 7.1.4 from WordPress.org</a>, or visit your WordPress Dashboard, click “Updates”, and then click “Update Now”. If you have sites that support automatic background updates, the update process will begin automatically.<br />WordPress 7.1.4 is a short-cycle release. The next major release will be <a href=\"https://make.wordpress.org/core/7-2/\">version 7.2</a>, currently planned for December 8th.</p>\n\n\n\n<p class=\"wp-block-paragraph\">For more information, please visit the <a href=\"https://wordpress.org/documentation/wordpress-version/version-7-1-4/\">WordPress 7.1.4 HelpHub site</a>.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Security updates included in this release</h2>\n\n\n\n<p class=\"wp-block-paragraph\">The security team would like to thank the following people and organizations for responsibly reporting vulnerabilities, and allowing them to be fixed in this release:</p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>A weakness in the WordPress upgrade process which can lead to remote code execution during the upgrade window, reported by <a href=\"https://www.picussecurity.com/resource/author/umut-bayram\">Umut Bayram</a>.</li>\n\n\n\n<li>A stored XSS with specially crafted block markup, reported by <a href=\"https://www.linkedin.com/in/rafiemuhammad/\">Rafie Muhammad</a> (Awesome Motive, Inc.).</li>\n\n\n\n<li>Privacy Data Removal Requests can be created in a way that leads to stored XSS, reported by Anthropic.</li>\n\n\n\n<li>Multiple stored XSS issues in the Interactivity API independently discovered by AnC and DatNLQ from VietSunshine Cyber Security, rekter0 and Anas cherni, <a href=\"https://decentsecurity.io/\">Marcel Karlsson (whoismarcel)</a>, and Weston Ruter, Jon Surrell, Alex Concha, and Luis Herranz of the WordPress Security Team.</li>\n\n\n\n<li>A stored denial of service issue in the Interactivity API, reported by Jon Surrell of the WordPress Security Team.</li>\n\n\n\n<li>A stored XSS in Customizer selective refresh, reported by <a href=\"https://www.linkedin.com/in/rafiemuhammad/\">Rafie Muhammad</a> (Awesome Motive, Inc.).</li>\n\n\n\n<li>A Stored XSS in the Categories block reported by Ben Bidner of the WordPress Security Team.</li>\n\n\n\n<li>Specially crafted User Logins can lead to a stored XSS reported by Anthropic.</li>\n\n\n\n<li>Unpublished customizer changesets can be discovered by unauthenticated users, reported by <a href=\"https://www.linkedin.com/in/antoniolorensius/\">Antonio Lorensius Silaban</a>.</li>\n\n\n\n<li>A Stored XSS in Playlist and image blocks, reported by Ben Bidner of the WordPress Security Team.</li>\n\n\n\n<li>Stored XSS in <code>core/comments-pagination-next</code> and <code>core/comments-pagination-previous</code> blocks, reported by Alex Concha of the WordPress Security Team.</li>\n\n\n\n<li>Notes can be read by privileged users that lack access to edit the post the note is attached to, reported by Ramon of the WordPress Security Team.</li>\n\n\n\n<li>An update to the bundled root certificates due to the eMudhra revocation.</li>\n</ul>\n\n\n\n<h2 class=\"wp-block-heading\">Thank you to these WordPress contributors</h2>\n\n\n\n<p class=\"wp-block-paragraph\">This release was led by <a href=\"https://profiles.wordpress.org/jorbin/\">Aaron Jorbin</a> and <a href=\"https://profiles.wordpress.org/ntsekouras/\">Nik Tsekouras</a>. WordPress 7.1.4 would not have been possible without the contributions of the following people:</p>\n\n\n\n<p class=\"is-style-wporg-props-medium wp-block-paragraph\"><a href=\"https://w.org/@jorbin\">Aaron Jorbin</a>, <a href=\"https://w.org/@adamsilverstein\">Adam Silverstein</a>, <a href=\"https://w.org/@xknown\">Alex Concha</a>, <a href=\"https://w.org/@aduth\">Andrew Duthie</a>, <a href=\"https://w.org/@andrewserong\">Andrew Serong</a>, <a href=\"https://w.org/@darerodz\">David Arenas</a>, <a href=\"https://w.org/@dmsnell\">Dennis Snell</a>, <a href=\"https://w.org/@ellatrix\">Ella Van Durpe</a>, <a href=\"https://w.org/@mamaduka\">George Mamadashvili</a>, <a href=\"https://w.org/@isabel_brison\">Isabel Brison</a>, <a href=\"https://w.org/@whyisjake\">Jake Spurlock</a>, <a href=\"https://w.org/@audrasjb\">Jb Audras</a>, <a href=\"https://w.org/@jeremyfelt\">Jeremy Felt</a>, <a href=\"https://w.org/@johnbillion\">John Blackbourn</a>, <a href=\"https://w.org/@jonsurrell\">Jon Surrell</a>, <a href=\"https://w.org/@desrosj\">Jonathan Desrosiers</a>, <a href=\"https://profiles.wordpress.org/kirasong/\">Kira Song,</a><a href=\"https://w.org/@lancewillett\">Lance Willett</a>, <a href=\"https://w.org/@luisherranz\">luisherranz</a>, <a href=\"https://w.org/@mciampini\">Marco Ciampini</a>, <a href=\"https://w.org/@marcs0h\">marcs0h</a>, <a href=\"https://w.org/@tyxla\">Marin Atanasov</a>, <a href=\"https://w.org/@santosguillamot\">Mario Santos</a>, <a href=\"https://w.org/@mcsf\">Miguel Fonseca</a>, <a href=\"https://w.org/@ntsekouras\">Nik Tsekouras</a>, <a href=\"https://w.org/@peterwilsoncc\">Peter Wilson</a>, <a href=\"https://w.org/@ramonopoly\">ramonopoly</a>, <a href=\"https://w.org/@rfaile313\">Rudy Faile</a>, <a href=\"https://w.org/@sergeybiryukov\">Sergey Biryukov</a>, <a href=\"https://w.org/@umut3806\">umut3806</a>, <a href=\"https://w.org/@westonruter\">Weston Ruter</a></p>\n\n\n\n<h2 class=\"wp-block-heading\">Backports</h2>\n\n\n\n<p class=\"wp-block-paragraph\">As a courtesy, the security fixes were backported to all branches eligible to receive security fixes (currently through 4.7). As a reminder, <strong>only the most recent version of WordPress is actively supported</strong>. The backports are in progress and will ship as they become ready.</p>\n\n\n\n<p class=\"wp-block-paragraph\">WordPress 7.2 Beta 3 has also been released, containing all applicable fixes.</p>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Wed, 28 Oct 2026 17:13:02 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:12:\"Aaron Jorbin\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:29;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:119:\"WPTavern: #239 – Remkus de Vries on How Scanfully 2.0 Is Making WordPress Security and Performance Monitoring Simpler\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:48:\"https://wptavern.com/?post_type=podcast&p=209252\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:134:\"https://wptavern.com/podcast/239-remkus-de-vries-on-how-scanfully-2-0-is-making-wordpress-security-and-performance-monitoring-simpler/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:46690:\"<details>Transcript<div>\n<p class=\"wp-block-paragraph\">[00:00:19] <strong>Nathan Wrigley:</strong> Welcome to the Jukebox podcast from WP Tavern. My name is Nathan Wrigley.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Jukebox is a podcast which is dedicated to all things WordPress. The people, the events, the plugins, the blocks, the themes, and in this case how Scanfully 2.0 is making WordPress security and performance monitoring simpler.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you&#8217;d like to subscribe to the podcast, you can do that by searching for WP Tavern in your podcast player of choice, or by going to wptavern.com/feed/podcast, and you can copy that URL into most podcast players.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you have a topic that you&#8217;d like us to feature on the podcast, I&#8217;m keen to hear from you and hopefully get you, or your idea, featured on the show. Head to wptavern.com/contact/jukebox, and use the form there.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So on the podcast today we have Remkus de Vries. Remkus has been active in the WordPress space for over 20 years, starting out with his own agency focused on high performance, scalable WordPress websites. Over time he has diversified into education and community building with projects like WithinWP, and a new initiative, The Guild, which is a paid community aimed at helping people build smarter, more performance, sites through a first principles approach.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Our conversation centres on Scanfully, a site health and monitoring SaaS Remkus co-founded, which recently hit version 2.0. Scanfully&#8217;s focus is giving users meaningful, actionable, insights into WordPress site, health, security performance, email, deliverability, DNS, and more. Packing all this data into an easy to understand dashboard.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We talk about Remkus&#8217; motivation for diving deep into the complexities of WordPress monitoring, and why many users struggle to keep on top of the technical side of their websites. Remkus argues that too many site owners are stuck in a reactive mode, only investigating issues once something breaks. And Scanfully aims to change that mindset by making ongoing health checks accessible and easy to parse, even for the spreadsheet averse.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Remkus walks us through the products evolution, including the 2.0 update that aimed to reimagine their dashboard experience, added public APIs, and introduced tools like MCP AI integration, empowering users to query their sites health conversationally.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We also get into recent and upcoming features such as WooCommerce checkout monitoring, activity logs, and future add-ons designed to cover forms and other business critical flows.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you manage multiple WordPress sites, run an agency or are simply interested in building more robust futureproof WordPress projects, this episode is for you.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you&#8217;re interested in finding out more, you can find all of the links in the show notes by heading to wptavern.com/podcast, where you can find all the other episodes as well.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And so without further delay, I bring you Remkus de Vries.</p>\n\n\n\n<p class=\"wp-block-paragraph\">I&#8217;m joined on the podcast by Remkus de Vries. Hello, Remkus.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:29] <strong>Remkus:</strong> Hello, Nathan.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:30] <strong>Nathan Wrigley:</strong> It&#8217;s been a while. Remkus and I have been on many calls in the last few days and weeks. We&#8217;re going to have today about a project that Remkus has been actively involved in for a number of years. It&#8217;s called Scanfully. We&#8217;ve reached version, I&#8217;m going to say 2.0, let&#8217;s go with that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:46] <strong>Remkus:</strong> Yeah. Yeah. Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:47] <strong>Nathan Wrigley:</strong> But over the last few days it&#8217;s actually advanced a little beyond that. So that&#8217;s going to be the main focus.</p>\n\n\n\n<p class=\"wp-block-paragraph\">I would probably urge listeners to this podcast. If you want to understand what the product is and how it works, maybe press pause. Go to Scanfully.com, so scanfully.com, and then come back and you&#8217;ll understand fully what the product is.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Before we get stuck into updates and product and what it all does. Very briefly, Remkus, do you want to just tell us a little bit about you, your backstory, WordPress space, that kind of thing?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:04:17] <strong>Remkus:</strong> Yeah, sure. Been in the WordPress space, active, 20 plus years now. Started with an agency, very quickly moved into complex performance scaling, more complicated type of sites.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Ran a niche agency like that for a very long time. In the last couple of years I&#8217;ve been doing some diversification. I have withinwp, which is a WordPress, how do I explain this? Because this is also in transit, but it&#8217;s a podcast, it&#8217;s a newsletter. One that&#8217;s being cited by This Week in WordPress a lot, I should say.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And part of it is the educational side, which is the part that I&#8217;m building out currently. And what I mean with educational side, that I&#8217;m preparing a community, a paid community, that has the sole goal to help you better understand WordPress and build better sites, smarter sites, more performance sites, that sort of stuff. Basic first principles type approach.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And that is roughly how I look at WordPress. And Scanfully is something I started with my co-founder Barry, let&#8217;s call it three years ago. And from a similar angle, we want to solve, essentially site health and performance monitoring tool of your WordPress site in the broadest sense of the word. Meaning the word Scanfully is literal. We scan fully and what we&#8217;re not scanning fully currently, we will be.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:05:32] <strong>Nathan Wrigley:</strong> Okay. Thank you. Can I ask a question? May touch on your personality, I guess. All those years ago, 20 plus years when you came into WordPress. How can you explain why you delved into this bit? Because there were so many ways that you could have gone, but you&#8217;ve really made scanning, and site health, and monitoring and performance, that is your thing. Is there a bit of that which, speaks to you on some level? Do you find yourself drawn in that direction, no matter where you look on the internet?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:05:58] <strong>Remkus:</strong> Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:05:59] <strong>Nathan Wrigley:</strong> Do you enjoy data analytics, spreadsheets, numbers, all of that?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:06:03] <strong>Remkus:</strong> I wouldn&#8217;t call it enjoy, but, I&#8217;ve always been good at it. I always found it fun to some degree. But in general, I get bored quite easily. If I&#8217;m to stick with a topic, it needs to be the complicated version of a topic. To me, in web development, that quickly revolves around all the things that make a WordPress site more tricky to scale, or more tricky to make fast, or more tricky to fill in the blank. There&#8217;s tonnes of different subtopics to that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:06:25] <strong>Nathan Wrigley:</strong> Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:06:26] <strong>Remkus:</strong> And that then gives you a different view of what is important. And Scanfully is one of the answers to that. we. See that there&#8217;s, I think the whole industry is levelling up in a way. I don&#8217;t think it&#8217;s happening fast enough, but part of it forces you to start thinking about things in a more professional way, like more preemptively understanding what is something that&#8217;s going on. What is a trend on your site? What do you see happening? And I think we&#8217;re still too much on the reactive side of things. So if my side is down, or if somebody complains it&#8217;s slow, then I&#8217;ll have a look. And we want to change that awareness and make it one of your first thoughts instead of an afterthought.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:07:02] <strong>Nathan Wrigley:</strong> It&#8217;s a curious thing then that the complexity which you enjoy, in a sense, you require other people to not enjoy it as much as you, in order for you to have a product. And I am one of those people. If you present me with a, I don&#8217;t know, a Google Analytics dashboard, or a spreadsheet which goes beyond about four rows, then I quickly lose interest. I genuinely can&#8217;t maintain my effort over there. I glaze over and don&#8217;t enjoy it.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And so part of the problem with dealing with WordPress is getting over that hump. Maintaining the interest in an area that I feel ill-equipped, not just ill-equipped, completely out of my depth.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And so having tooling, the likes of which you&#8217;ve built with Scanfully enables people like me to actually stand back and go, okay, that complicated thing is made more easy. I can actually start to understand it in real terms, with data and charts that are less overwhelming. And I guess that&#8217;s the point.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:07:53] <strong>Remkus:</strong> That is the point, and that is essentially also the driver, why we went from dashboard version 1.x to now, 2.x. Because it&#8217;s very easy when you&#8217;re on the more technical side of things and you kind of understand what the signal is and what it&#8217;s implying to forget what the person who doesn&#8217;t understand the extra layers and the assumptions that go underneath. Like what does that actually mean?</p>\n\n\n\n<p class=\"wp-block-paragraph\">The 2.0 rebrand. Because it&#8217;s not a rebrand in terms of what we do, but it&#8217;s a rebrand and how we interpret every single version of the monitoring metrics that we collect, how we present it, and what we allow you to do with it. Everything has been rethought. It&#8217;s been a, I think in total, we&#8217;ve had about four or five months of just working with a redesign. And we call it a redesign because it is, because it visually looks different.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We&#8217;ve got all this feedback of how people are using it. And a common theme was, we&#8217;re missing this, we&#8217;re missing that. Could you make that easier? So we were like, okay, that&#8217;s a lot of stuff pointing in the same direction. Why don&#8217;t we start rethinking how we&#8217;re going about helping you figure this out?</p>\n\n\n\n<p class=\"wp-block-paragraph\">And I&#8217;ll give you a very concrete example. So if a site goes down, because we have an uptime monitoring, you get a notification. But if it&#8217;s the server that goes down and you have 25 sites on that server, it doesn&#8217;t make a lot of sense for you to receive 25 emails.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:09:05] <strong>Nathan Wrigley:</strong> No.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:09:06] <strong>Remkus:</strong> So gathering information per monitoring alert is something we&#8217;re doing now. And, the same goes for if there&#8217;s, I don&#8217;t know, if the latest plugin you&#8217;re using on all of your sites has something that needs to be fixed, or something that is already fixed. So let&#8217;s assume there&#8217;s a security release for it. You don&#8217;t need to know that 25 emails. You need to know there&#8217;s one email, and these are the sites that are affected. But you also want to know, is this a high risk? Is this a medium risk? Is this a low risk?</p>\n\n\n\n<p class=\"wp-block-paragraph\">Because there&#8217;s plenty of security stuff that is so close to impossible to replicate that, do I need to act right now? Maybe, but we give you the insight that you can act upon it. Like it&#8217;s not, we&#8217;re not forcing you to pay all the attention all the time.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And it&#8217;s things like that. So we had the data already, but the question then becomes, how do we make this digestible? How does this become a signal, versus the noise that it&#8217;s also is? So that&#8217;s a lot of rethinking. That&#8217;s a lot of rethinking in what is valuable to share, and how is it valuable to share and what are the things you would like to do with certain things?</p>\n\n\n\n<p class=\"wp-block-paragraph\">So, an example, related to that is what if there is an update available for a plugin that you&#8217;re using in a few places? But there&#8217;s no fix yet. Do we need to send you every single day that there is a security update? Or there&#8217;s a security issue? Probably not. So why don&#8217;t we allow you to snooze a particular alert? It&#8217;s simple things like that. And I say simple. It&#8217;s not simple to implement, but.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:10:27] <strong>Nathan Wrigley:</strong> Simple on the front end.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:10:28] <strong>Remkus:</strong> Yeah. Simple for you as an end user. So that was a lot of thinking and figuring out how do we make this more pleasurable, for as pleasurable as the topic itself is.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:10:39] <strong>Nathan Wrigley:</strong> I&#8217;m going to circle back to the product in a moment, but I&#8217;m going to ask you a curious question.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:10:43] <strong>Remkus:</strong> Yep.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:10:43] <strong>Nathan Wrigley:</strong> You may balk at this question and think, okay, that&#8217;s unusual and a bit weird. Is the WordPress space for you quite an exasperating thing. And what I mean by that is, you are obviously steeped in this knowledge, about how things can go wrong, and how a poor implementation of something over here can have catastrophic effects over there. Given enough time, and the stars aligning in a certain way.</p>\n\n\n\n<p class=\"wp-block-paragraph\">I don&#8217;t know how to describe this. Does that mean that everywhere you look, you just see catastrophe and problems. And you open up a WordPress website, you&#8217;ve got a new client or somebody&#8217;s onboarded you with the plugin. You look inside and you sort of face plant, head slap. Okay. All the stuff that I know, which is second nature to me. Why don&#8217;t they all know this? There&#8217;s no question there, but can you see what I&#8217;m trying to.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:11:27] <strong>Remkus:</strong> Yeah. Yeah, I can. You&#8217;re not recording the video. The people listening didn&#8217;t see me nod along the way of what you were saying, but yes. If you understand things. So there&#8217;s a principle called first principles. Which means everything we approach, we should approach from the first principles. Like what is the base layer of where to solve problems. And, this is not even just WordPress, this is life, I guess.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But there&#8217;s a big tendency for people to look at a problem and then have the idea of how they want to fix the problem, but they don&#8217;t actually look at the layer, it should be fixed. They just want to fix the outing. That&#8217;s not really a fix, right. You fix things at the bottom layer. You can identify where the problem lives.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And when that is your view on life slash work. Yeah, there&#8217;s moments where you go, how do you, not look into this? This is your work, this is your job, this is your, competency. Why do you not dive into this? But I also understand that&#8217;s not for everybody to be in that layer of how I look at things. And it&#8217;s not me wanting to force other people, my model of the world, but it is something where I go, you don&#8217;t need to do my model of the world, but there&#8217;s some stuff that you actually should be quite skilled on because it&#8217;s part of your job. Because it touches your job. It touches the clients you serve and all of that sort of stuff. Long-winded answer, but yes, I have those moments.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:12:39] <strong>Nathan Wrigley:</strong> Yeah, I guess it must be the same no matter which bit of WordPress you&#8217;re in. So for example, I don&#8217;t know if you&#8217;re a front end designer and you see catastrophic use of fonts and spacing and typography, and it would make the head plant moment occur. But also accessibility. And there&#8217;s these tendrils isn&#8217;t there? And we can&#8217;t become expert at all of them, but many of the things are inconveniences. Where if something goes wrong, it&#8217;s annoying, but that&#8217;s probably where it ends.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Whereas the stuff that you are dealing with, there&#8217;s a potential for catastrophe to occur. The website gets defaced or taken down, or the server gets compromised and is used in some crazy way that we can&#8217;t imagine. That makes your part I suppose a little bit more essential. But then, as as you said, we can&#8217;t all be experts, and relying on the expertise that you have and the tools that you&#8217;ve built. I suppose that&#8217;s why you occupy the space that you do.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:13:33] <strong>Remkus:</strong> Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:13:33] <strong>Nathan Wrigley:</strong> Because not everybody can spend the time becoming as knowledgeable as, as you have become.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:13:37] <strong>Remkus:</strong> And I, for the record, I don&#8217;t acclaim to have all the knowledge. I just happen to specialise on a few things I find highly interesting.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:13:44] <strong>Nathan Wrigley:</strong> Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:13:44] <strong>Remkus:</strong> My goal for the Within WordPress community that I want to build, which is called The Guild, is exactly to behave like a guild. We&#8217;re all there to elevate each other up. That is what a guild is supposed to do. And, back in the day, you had guilds that were that you went there, you were part of it, and all that had as a goal was to help you elevate your craft.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And we need to start thinking about what we do as a craft. And how do you do your craft? Well there&#8217;s tonnes of different ways to do the craft that&#8217;s putting bread on the table. But if you&#8217;re not actively developing yourself to become better at your craft, then what are you doing? You&#8217;re, essentially behind in the first week you start working. And you&#8217;re only playing catch up. And most people have forgotten that they&#8217;re just in the game of playing catch up. Which I think is a shame.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:14:26] <strong>Nathan Wrigley:</strong> You&#8217;ve alluded from various bits and pieces that you said. You&#8217;ve suggested what Scanfully does. So we have an idea that there&#8217;s charts, and graphs, and information about things that could be going wrong with your website in the background. But we haven&#8217;t really explained what the tool does at its core.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So putting the update to one side, if we just examine why you built the tool in the first place, what does it broadly do? And then we can get into what it most recently does and how it&#8217;s been adapted for the 2.x version.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:14:55] <strong>Remkus:</strong> So Scanfully is about giving you the information so you know what broke on your site, and what changed and what things you need to pay attention to. Anywhere from critical stuff. So vulnerabilities, downtime, to also adjacent critically, are my emails being sent from the site? Does that still work? So we do email monitoring. We do DNS checking.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We do all kinds of site health, like actual site health menu inside of WordPress. We pull in that data so you can see and you can filter for which of my sites are in PHP seven point, whatever still? You can figure that out.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you need to do all kinds of filtering on data that is living in all of your WordPress sites. That&#8217;s a pain in the ass to have to click through every single site to figure out what&#8217;s what. And maybe your control panel on your server tells you something, but Scanfully will tell you everything.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We will tell you how large the uploads folder is. We will tell you, is your certificate about to be renewed, yes or no? Did anything go wrong when that happened? Things like that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So anything and everything that goes into the bucket of what is site health, what is a healthy site mean? We are monitoring, or we will be monitoring. We still have a very long list of stuff we&#8217;re going to add. But yeah, the goal for Scanfully is to have you be in control of what&#8217;s going on with your site.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:16:19] <strong>Nathan Wrigley:</strong> Ok thank you. I have some follow up questions just to that, so the first one is. Who has been, or who potentially is your ideal customer? So I&#8217;m going to broadly bucket that as, I don&#8217;t know the person who&#8217;s got just one WordPress, or a handful of WordPress websites and they manage that themselves. Are they the kind of people that you are trying to get? And then I&#8217;m going to go into different buckets of enterprise perhaps. Agency level customers. I&#8217;m imagining there&#8217;s some perfect fit there.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:16:42] <strong>Remkus:</strong> Yep.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:16:43] <strong>Nathan Wrigley:</strong> And then also I&#8217;m wondering if hosting companies also might be a customer of yours in terms of adding this in, to a deployed website on their platform.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:16:53] <strong>Remkus:</strong> They are now. One of the features we added, we kind of already had it, but we added publicly now, with Scanfully 2.0 is a public API. Which means if there&#8217;s a public API, anybody can hook into whatever data we have, and display that in their dashboard or website, or wherever they would choose to do so.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So yes, we cast a broad net, But the goal is for any client that needs to be in control of what&#8217;s going on with their site. But the reality is this is from freelancers to agencies and indeed, hosting type of adjacent companies. Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:17:25] <strong>Nathan Wrigley:</strong> Right. So there&#8217;s a fit across all of those three things that I just mentioned?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:17:29] <strong>Remkus:</strong> Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:17:29] <strong>Nathan Wrigley:</strong> And do you have pricing that reflects that? So in other words, can you buy a single licence, and a multiple licence and a, I don&#8217;t know, an unlimited licence?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:17:37] <strong>Remkus:</strong> It&#8217;s a flat structure. It&#8217;s 299 a month per site. Simple.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:17:41] <strong>Nathan Wrigley:</strong> And, in terms of the level of depth of technical understanding that you have to have in order to get the tool working, is this more a case of upload the plugin, activate the plugin, and then there are some sensible defaults? Or do we have to do a tonne of background research to understand what&#8217;s going on? And maybe that&#8217;ll lead us into the 2.0 stuff in a minute.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:17:59] <strong>Remkus:</strong> There&#8217;s nothing more than installing and activating.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:03] <strong>Nathan Wrigley:</strong> Okay.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:03] <strong>Remkus:</strong> And even the activating we have made as frictionless as possible. The only thing you need to do is once the plugin is activated, you click that button that says connect to your Scanfully dashboard, and assuming you&#8217;re already logged in there, clicking that button is all you need to do. There&#8217;s no copying pasting of keys and other weird stuff.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:18] <strong>Nathan Wrigley:</strong> So I presume from what you said earlier, the 2.x, the article that I&#8217;m going to link to in the show notes on the WP Tavern website is about 2.0, but I understand time has passed and probably by the time this episode will be on two point something.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:32] <strong>Remkus:</strong> 2.3.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:33] <strong>Nathan Wrigley:</strong> It would appear that you obviously took a stab at what you thought people would like to see in their dashboards. That&#8217;s one of the things that&#8217;s been updated. How did you adapt that over time then? Because, like we said earlier, getting complicated data to be easy to understand, that is a proper art form. I don&#8217;t think you&#8217;ll probably ever end this journey.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:52] <strong>Remkus:</strong> No. No.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:54] <strong>Nathan Wrigley:</strong> You&#8217;ll just be iterating forever.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:54] <strong>Remkus:</strong> Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:54] <strong>Nathan Wrigley:</strong> But is that one of the things that you got feedback on? Okay, it&#8217;s good, but we&#8217;re still confused. Make it simpler to understand. Just describe that side of things.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:19:02] <strong>Remkus:</strong> Yeah. So that&#8217;s the part where you go, how do I go from showing noise? Because there&#8217;s a tonne of data that you actually need to be in control of. But how do I make that, easy, digestible?</p>\n\n\n\n<p class=\"wp-block-paragraph\">So one of the solutions we came up with, and that seems to have gone down really well, people like it, is essentially every view on top has the most important things. So we&#8217;ll tell you if there&#8217;s stuff that you need to be updating. We&#8217;ll tell you if email is not being delivered. We&#8217;ll tell you if the percentage of up and down times you&#8217;re having is odd, or requires more investigation. Essentially we&#8217;re helping you figure out the important things per monitor, per view. And then from there, you can deep dive into the data that we collect and figure out things.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:19:46] <strong>Nathan Wrigley:</strong> You&#8217;re moving away from graphs and data first, into more of a human readable summation in a couple of sentences?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:19:53] <strong>Remkus:</strong> Yep.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:19:53] <strong>Nathan Wrigley:</strong> Okay. So you can finally parse what&#8217;s going on. Okay. That&#8217;s good to know. And you said that&#8217;s been well received?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:19:59] <strong>Remkus:</strong> Yeah, people like it.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:20:00] <strong>Nathan Wrigley:</strong> Okay.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:20:00] <strong>Remkus:</strong> It&#8217;s more straightforward in terms of quickly understanding what&#8217;s going on. That was a big part, and we also wanted to make that information available more easily as well. And what I mean with that is that inside the API you can query this now.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But more conveniently, we have an MCP server available as well. So you can connect us to your favourite LLM, your favourite AI and just ask the questions. Like let&#8217;s say you have a bunch of sites for different clients in there, but one client has a specific question. You&#8217;ve labelled them accordingly inside of Scanfully. You can do that now. And then your LLM, you can ask, either ask it to label it, you say these are the domains, labelled them with this client. And then tell me do I have any vulnerabilities? Is email being sent out correctly? Are there any weird DNS changes? What does my uptime look like? And we&#8217;ll tell you.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:20:46] <strong>Nathan Wrigley:</strong> So the API enables you to, I don&#8217;t know, if you&#8217;re an agency owner, you could build a dashboard, for example, for your clients or something like that. So you could put charts and information in a place where your client can go and see it in a way that makes sense for them.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:20:58] <strong>Remkus:</strong> Correct.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:20:59] <strong>Nathan Wrigley:</strong> But the MCP enables you to kind of have a conversation with the security and the current state of your WordPress website. That&#8217;s so intriguing.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:21:07] <strong>Remkus:</strong> Yep.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:21:08] <strong>Nathan Wrigley:</strong> Have you discovered some interesting, quirky things in there? You know, you you ask it a particular thing and a surprising thing came back?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:21:13] <strong>Remkus:</strong> I got for one of the sites that I have in my account, I got some intermittent email is not being delivered. And I go, why does it turn on and off all the time? What&#8217;s going on here? So I ask it to investigate, look at any commonalities. Look at anything that stands out. And it sure enough came up with something that goes along the lines of there&#8217;s conflicting DNS records. So if there&#8217;s multiple validation records, I was using a transactional email service for that. But their validation system allows you to have old validation DNS records in there as well. And apparently their system picked up both intermittently. How do you figure that out?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:21:48] <strong>Nathan Wrigley:</strong> With an MCP, it turns out. Yeah. That&#8217;s really interesting.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:21:50] <strong>Remkus:</strong> Yeah. So it told me, double check the DNS records here, because it looks like, and then I go, okay, let me check that. And I go in, I dive deeper into the dashboard for my transactional email provider. And I go, hold on. This is, okay. I get it now. So let me delete those. I deleted them, and the problem solved.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:07] <strong>Nathan Wrigley:</strong> Does your MCP enable bi-directional things to happen? Or is it basically read only?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:12] <strong>Remkus:</strong> It is read only on the data. It&#8217;s write on, like I said, if you want to create labels and other things like that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:18] <strong>Nathan Wrigley:</strong> Unharmful stuff is right.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:20] <strong>Remkus:</strong> Correct.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:21] <strong>Nathan Wrigley:</strong> Because you are dealing with quite a lot of powerful stuff here, and writing in the wrong direction in a silly way, which let&#8217;s be honest, MCPs enable us to be very silly very quickly.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:30] <strong>Remkus:</strong> Yeah. Yeah. Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:31] <strong>Nathan Wrigley:</strong> Okay, that&#8217;s good to know. It&#8217;s basically read only.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Okay. We&#8217;ve got the dashboard updates with more human readable data. We&#8217;ve got the API. We&#8217;ve got the MCP. Anything else in Scanfully 2.x?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:43] <strong>Remkus:</strong> If we include 2.x, the release we did yesterday is 2.3. And in that we have much smarter user activity tracking. Content changes. Not only who did the change, but what is the change, that sort of stuff.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We pull everything out of WordPress into our dashboard. So for instance, we have a full WordPress activity log and in that log, we collect all the things. Whatever happens on your WordPress site, so that&#8217;s a plugin installed, updated, all those things. So now user activity is in there as well.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And it&#8217;s also the things happening to your user. So elevated admin rights given to a user. Was that supposed to happen? An email address change to a administrator is something you would want to know. On a multi-site, if a user gets to have super admin, you&#8217;ll want to have that logged. So things like that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So the 2.0 essentially, which is a week and a half ago, it allowed us to have a whole bunch of other refinements we had essentially lined up. We have a much better foundation to build these things on top of what we now have. So we can move forward much faster.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:23:42] <strong>Nathan Wrigley:</strong> We&#8217;ve already agreed pre hitting the record button that there&#8217;s a whole load of stuff which you know is going to occur, but we are not quite ready for public disclosure at the moment.</p>\n\n\n\n<p class=\"wp-block-paragraph\">One thing that we didn&#8217;t touch on, which I suspect people will be listening to this thinking, okay, hang on a minute. How does it all work in terms of, is there a scanfully.com/whatever login? In other words, do you have a SaaS sort of admin section?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:06] <strong>Remkus:</strong> Yes.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:06] <strong>Nathan Wrigley:</strong> So the plugin kind of binds to that, because I miss that at the beginning.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:11] <strong>Remkus:</strong> Yeah, correct.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:11] <strong>Nathan Wrigley:</strong> We probably should have explained that. So the plugin binds to the SaaS. The SaaS holds the data. And in that way, for example, an agency could have an overview of all the sites that they&#8217;re managing and that kind of thing?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:23] <strong>Remkus:</strong> And everything that happens on that site that is worthy of tracking and monitoring for. So again, the activity log is a good example. A WordPress activity log should not live inside the WordPress site, period. From a performance standpoint, it makes no sense. Most databases for most hosting companies have issues when you track and sort a, let&#8217;s call it a busy website.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So what we do is we asynchronously pull all of that into our dashboard. So if your site goes down for whatever reason, we have a track record of what the last things that were happening on your site.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:53] <strong>Nathan Wrigley:</strong> Oh yeah, of course.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:55] <strong>Remkus:</strong> There&#8217;s just an easier way of being in check.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:58] <strong>Nathan Wrigley:</strong> So you&#8217;d log into the SaaS, everything&#8217;s there. So if your site does have some catastrophic failure, then at least you can begin to understand what&#8217;s going on.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:25:06] <strong>Remkus:</strong> Yep.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:25:07] <strong>Nathan Wrigley:</strong> And work backwards from there?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:25:08] <strong>Remkus:</strong> Yep.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:25:08] <strong>Nathan Wrigley:</strong> I think that&#8217;s probably all the questions that I&#8217;ve got. Is there anything that we didn&#8217;t touch on that you wanted to mention?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:25:14] <strong>Remkus:</strong> I think what&#8217;s fun to mention is that this whole rewrite allowed us to start building add-ons as well.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So the base monitor service as we have it currently is what Scanfully is. So that&#8217;s Scanfully monitor. But we&#8217;re, and probably by the time this podcast is being aired, I think we will have, the beta available for WooCommerce checkout monitoring.</p>\n\n\n\n<p class=\"wp-block-paragraph\">This is essentially an add-on to the base service. And what it does, we fully check everything that goes into, from is the product available in your WooCommerce, website? Can I add it to cart? Can I then go to cart? Can I then start the checkout? Can I fill out the checkout? Can I start the processing of the actual payment. So we don&#8217;t go into the payment itself? So they&#8217;re test orders, so to say.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:25:59] <strong>Nathan Wrigley:</strong> But the moment right before?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:01] <strong>Remkus:</strong> Yep to the moment, right before. So we&#8217;ll tell you if we can&#8217;t reach the payments provider. We&#8217;ll tell you that, but we can&#8217;t, at this moment in time, do the step beyond that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:09] <strong>Nathan Wrigley:</strong> So how does that work then? Does it literally do that as if it&#8217;s a human being, you know?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:13] <strong>Remkus:</strong> It does.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:14] <strong>Nathan Wrigley:</strong> Is some part of your SaaS kind of opening up a browser somewhere in effect and doing that journey. Finding a product, putting it in the cart, checking the cart, and so on.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:21] <strong>Remkus:</strong> And the fun thing is you get to define what that journey looks like. So if you have a custom WooCommerce checkout, or any of the other solutions. We account for that. And you can tell us if it&#8217;s any different from what their default is, or the WooCommerce default.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And from there you get to essentially define the journey. And then the journey is stored as the thing we&#8217;re checking. And we&#8217;re doing this from the external, obviously. So it doesn&#8217;t touch any monetary things. Nothing gets charged, nothing gets booked. And the plugin that is providing the connection to our dashboard, that plugin cleans up whatever test orders were made in that process.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:56] <strong>Nathan Wrigley:</strong> Right, okay. So it&#8217;s not 3000 carts.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:58] <strong>Remkus:</strong> Yeah, we don&#8217;t, want to do that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:00] <strong>Nathan Wrigley:</strong> Do you enable that in other ways as well? for example, I&#8217;m thinking maybe a contact form is incredibly important to somebody&#8217;s business.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:07] <strong>Remkus:</strong> Yep, that&#8217;ll be next.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:08] <strong>Nathan Wrigley:</strong> Is it possible to, outside of WordPress, visit a contact page, fill out the form fields, and then even, I don&#8217;t know, maybe even check on the other side to see if an email landed or something like that?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:17] <strong>Remkus:</strong> A part of it we&#8217;ve already solved with the email monitoring, or I should say email deliverability monitoring.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:23] <strong>Nathan Wrigley:</strong> Of course you&#8217;re on the inside there, so you can see whether that got sent.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:27] <strong>Remkus:</strong> Yes. But once we&#8217;re fully done with releasing the WooCommerce checkout monitoring, we are going to move to forms next. Because you&#8217;re right, if you have a landing pages, or a critical contact form or whatever, you need to know that that still is working as intended.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:41] <strong>Nathan Wrigley:</strong> So that&#8217;s a roadmap item. To be able to build these custom journeys, starting with WooCommerce, but more or less anything at some point. We want to see if people are going from A to B to C as we&#8217;d hoped.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:52] <strong>Remkus:</strong> Yeah, it&#8217;ll be a separate thing in the sense that WooCommerce will do a lot more than just checking the validity of the form, because that&#8217;s essentially on the WooCommerce side of things, that&#8217;s the checkout form. You fill out the form. And that&#8217;s the most similar to a general form. But yeah, we will build a separate feature inside of Scanfully that allows you to do all the types of monitoring you could possibly imagine you would need to make sure your forms are working the way you design them.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:28:16] <strong>Nathan Wrigley:</strong> Random question just before we end. How exciting do you find this? When you embark on the journey of building a product like this, you know, oh we&#8217;re going to do this thing, me and my friend. We&#8217;re going to do this thing, it&#8217;s going to be brilliant. And then the reality sets in, you know, it&#8217;s difficult, you&#8217;ve got to manage customers and all that kind of stuff. Do you still wake up excited by this?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:28:32] <strong>Remkus:</strong> Oh yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:28:33] <strong>Nathan Wrigley:</strong> Obviously you&#8217;re not going to say the opposite. I&#8217;m just wondering if that curiosity still remains and whether or not.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:28:38] <strong>Remkus:</strong> It does, because there&#8217;s just so much more we can still do. And the feedback that we&#8217;re getting is very positive. And especially with this new imagination of how this should be solved with the 2.x reboot I guess is probably the best word. It just excites me on the potentials that we have.</p>\n\n\n\n<p class=\"wp-block-paragraph\">The WooCommerce checkout monitoring is a good example, but there&#8217;s tonnes of other add-ons we have in mind where it just makes sense for you to have the Scanfully monitor as base. But there&#8217;s stuff that we can do more. We&#8217;re already gathering it in one way or another, and just to be super complete with what we&#8217;re presenting. Yeah, that excites me, yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:29:11] <strong>Nathan Wrigley:</strong> Okay, thank you for chatting to me today. Scanfully.com. Go and check it out. Remkus, where are you apart from there? If people want to contact you, are you available on a particular platform, I don&#8217;t know, social media or email or what?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:29:26] <strong>Remkus:</strong> remk.us</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:29:28] <strong>Nathan Wrigley:</strong> Nice. Of course you have that domain. Yeah. That&#8217;s lovely. In which case Remkus I will speak to you soon and thank you for chatting to us about Scanfully.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:29:38] <strong>Remkus:</strong> Thank you for having me.</p>\n</div></details>\n\n\n\n<p class=\"wp-block-paragraph\">On the podcast today we have <a href=\"https://www.linkedin.com/in/remkusdevries/\">Remkus de Vries</a>.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Remkus has been active in the WordPress space for over twenty years, starting out with his own agency focused on high-performance, scalable WordPress websites. Over time, he has diversified into education and community-building with projects like WithinWP and a new initiative, The Guild, which is a paid community aimed at helping people build smarter, more performant sites through a first principles approach.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Our conversation centers on Scanfully, a site health and monitoring SaaS Remkus co-founded, which recently hit version 2.0. Scanfully’s focus is giving users meaningful, actionable insights into WordPress site health, security, performance, email deliverability, DNS, and more, packing all this data into an easy to understand dashboard.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We talk about Remkus’ motivation for diving deep into the complexities of WordPress monitoring, and why many users struggle to keep on top of the technical side of their websites. Remkus argues that too many site owners are stuck in reactive mode, only investigating issues once something breaks, and Scanfully aims to change that mindset by making ongoing health checks accessible and easy to parse, even for the spreadsheet-averse.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Remkus walks us through the product’s evolution, including the 2.0 update that aimed to reimagine their dashboard experience, added public APIs, and introduced tools like MCP AI integration, empowering users to query their site’s health conversationally.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We also get into recent and upcoming features such as WooCommerce checkout monitoring, activity logs, and future add-ons designed to cover forms and other business-critical flows.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you manage multiple WordPress sites, run an agency, or are simply interested in building more robust, future-proof WordPress projects, this episode is for you.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Useful links</h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://scanfully.com\">Scanfully</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://scanfully.com/introducing-scanfully-2-0-a-completely-rebuilt-dashboard/\">Scanfully 2.0 release post</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://withinwp.com\">Within WordPress</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://withinwp.com/the-guild\">The Guild</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://remk.us\">Remkus&#8217; personal website</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://x.com/remkusdevries\">Remkus on X</a></p>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Wed, 28 Oct 2026 14:00:00 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:14:\"Nathan Wrigley\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:30;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:113:\"Open Channels FM: Linux Foundation on AI, Denmark’s Open Source Test, and Ben Thompson’s Take on the Internet\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2565496\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:112:\"https://openchannels.fm/linux-foundation-on-ai-denmarks-open-source-test-and-ben-thompsons-take-on-the-internet/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:131:\"AI quickens open source coding, Denmark tests Collabora beyond Microsoft Office, and Ben Thompson reflects on the changing internet\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Wed, 28 Oct 2026 13:55:48 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:8:\"Bob Dunn\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:31;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:86:\"Open Channels FM: When AI Mistakes Have Real-World Costs: Rethinking Delegated Control\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2564628\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:92:\"https://openchannels.fm/when-ai-mistakes-have-real-world-costs-rethinking-delegated-control/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:334:\"Advances in AI have opened an entirely new chapter in how we interact with technology. We are moving rapidly from asking questions of digital assistants to handing them the authority to take actions in the real world. This shift brings efficiency and convenience but also introduces a new kind of risk: errors that cost more [&#8230;]\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Wed, 28 Oct 2026 09:44:00 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:16:\"Open Channels FM\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:32;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"bbPress: bbPress 2.6.21 is out!\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:29:\"https://bbpress.org/?p=250418\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:55:\"https://bbpress.org/blog/2026/10/bbpress-2-6-21-is-out/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:2160:\"<p class=\"wp-block-paragraph\">bbPress 2.6.21 is a security and maintenance release. Everyone running bbPress should update. <img alt=\"🔒\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f512.png\" style=\"height: 1em;\" /></p>\n\n\n\n<p class=\"wp-block-paragraph\">This release strengthens access control across forum feeds, search results, BuddyPress activity, group forums, attachment requests, topic moves, and old topic and reply redirects. Inherited forum passwords now apply consistently when WordPress renders topic and reply content, and Akismet moderation requests now require HTTPS.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Maintenance fixes improve forum freshness and child-count queries, preserve metadata when database lookups fail, tighten route and user-profile handling, retain original dates and revision content during moderation and editing, and correct the administration reply destination controls. This release also repairs straightforward orphaned list items on WordPress 6.9 and newer, keeps generated bbPress excerpts available without duplicating content, adds the <code>ugc</code> relationship to topic and reply links, and refreshes administration icons for WordPress 7.2 and newer.</p>\n\n\n\n<p class=\"wp-block-paragraph\">bbPress 2.6.21 still requires WordPress 6.0 or newer and PHP 7.2 or newer, and is tested through WordPress 7.2. The database version remains 264, so no database upgrade is required. The <a href=\"https://codex.bbpress.org/releases/bbpress-2-6-21/\">2.6.21 upgrade notes</a> cover compatibility details.</p>\n\n\n\n<p class=\"wp-block-paragraph\">These changes are also in the 2.7 development branch, which remains 2.7.0-alpha-4. Thank you to antaloaalonso, arielmeadow, bor0, Clorith, dd32, deborah86, diddledani, lmstearn, netweb, noruzzaman, Otto42, Pebbleontheshore, r-a-y, rollybueno, sbask, shadow043, SirLouen, softglaze, terresquall, tharsheblows, and ton-ha for reports, patches, testing, and review.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://downloads.wordpress.org/plugin/bbpress.2.6.21.zip\">Download bbPress 2.6.21</a> from WordPress.org, or update from your WordPress dashboard.</p>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Tue, 27 Oct 2026 22:33:05 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:17:\"John James Jacoby\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:33;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:40:\"WordPress.org blog: WordPress 7.2 Beta 2\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:35:\"https://wordpress.org/news/?p=21890\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:56:\"https://wordpress.org/news/2026/10/wordpress-7-2-beta-2/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:5994:\"<p class=\"wp-block-paragraph\">WordPress 7.2 Beta 2 is ready for download and testing! </p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>This beta release is intended for testing and development</strong> only. Please do not install, run, or test this version of WordPress on production or mission-critical websites. Instead, use a test environment or local site to explore the new features.</p>\n\n\n\n<h2 class=\"wp-block-heading\">How to Test WordPress 7.2 Beta 2</h2>\n\n\n\n<p class=\"wp-block-paragraph\">You can test WordPress 7.2 Beta 2 in any of the following ways:</p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong>WordPress Beta Tester Plugin</strong></td><td>Install and activate the <a href=\"https://wordpress.org/plugins/wordpress-beta-tester/\" rel=\"noreferrer noopener\" target=\"_blank\">WordPress Beta Tester</a> plugin on a WordPress install. Select the “Bleeding edge” channel and “Beta/RC Only” stream.</td></tr><tr><td><strong>Direct Download</strong></td><td>Download the <a href=\"https://wordpress.org/wordpress-7.2-beta2.zip\">Beta 2 version (zip)</a> and install it on a WordPress website.</td></tr><tr><td><strong>Command Line (WP-CLI)</strong></td><td>Use this <a href=\"https://make.wordpress.org/cli/\" rel=\"noreferrer noopener\" target=\"_blank\">WP-CLI</a> command: <br /><code>wp core update --version=7.2-beta2</code></td></tr><tr><td><strong>WordPress Playground</strong></td><td>Use a <a href=\"https://playground.wordpress.net/?site-slug=kind-classic-mountain&amp;networking=no&amp;php=8.3&amp;wp=beta&amp;language=&amp;multisite=no\" rel=\"noopener\" target=\"_blank\">7.2 Beta 2 WordPress Playground instance</a> to test the software directly in your browser. No setup required-just click and go!</td></tr></tbody></table></figure>\n\n\n\n<p class=\"wp-block-paragraph\">The scheduled final release date for WordPress 7.2 is <strong><strong>December 8, 2026</strong></strong>. The full <a href=\"https://make.wordpress.org/core/2026/10/06/wordpress-7-2-release-party-schedule/\">release schedule can be found here</a>. Your help testing Beta and RC versions is vital to making this release as stable and powerful as possible. Thank you to everyone who contributes by testing!</p>\n\n\n\n<h2 class=\"wp-block-heading\">What&#8217;s in WordPress 7.2 Beta 2?</h2>\n\n\n\n<p class=\"wp-block-paragraph\">For technical details on the issues addressed since Beta 1, see the following links:</p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://core.trac.wordpress.org/query?status=closed&amp;changetime=10%2F21%2F2026..10%2F28%2F2026&amp;milestone=7.2&amp;group=component&amp;col=id&amp;col=milestone&amp;col=owner&amp;col=type&amp;col=priority&amp;order=id\">Closed 7.2 WordPress Core Trac tickets</a> since October 20, 2026</li>\n\n\n\n<li><a href=\"https://github.com/WordPress/gutenberg/commits/wp/7.2?since=2026-10-21&amp;until=2026-10-28\">7.2 Gutenberg commits</a> since October 20, 2026</li>\n</ul>\n\n\n\n<h3 class=\"wp-block-heading\">Continued Improvements to WordPress 7.2</h3>\n\n\n\n<p class=\"wp-block-paragraph\">WordPress 7.2 Beta 2 builds on the first beta with additional enhancements, bug fixes, and refinements across the administration experience and developer APIs.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Development continues on the <strong>Abilities API</strong>, including content querying, capability requirements, and improvements to schema handling and permissions. New server-side registration capabilities for <strong>DataViews and DataForm</strong> also provide developers with more ways to extend WordPress interfaces.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Additional work includes improvements to REST API flexibility, admin asset loading, and the transition to modern SVG icons throughout WordPress administration.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Learn more:</strong> <a href=\"https://core.trac.wordpress.org/ticket/66268\">Trac #66268</a>, <a href=\"https://core.trac.wordpress.org/ticket/66325\">Trac #66325</a>, <a href=\"https://core.trac.wordpress.org/ticket/66229\">Trac #66229</a>, <a href=\"https://core.trac.wordpress.org/ticket/66343\">Trac #66343</a>, <a href=\"https://core.trac.wordpress.org/ticket/57548\">Trac #57548</a>, <a href=\"https://core.trac.wordpress.org/ticket/65089\">Trac #65089</a></p>\n\n\n\n<h2 class=\"wp-block-heading\">How important is your testing?</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Testing for issues is a critical part of developing any software, and it’s a meaningful way for anyone to contribute – whether or not you have experience. <a href=\"https://make.wordpress.org/test/2026/10/20/help-test-wordpress-7-2/\">Details on what to test in WordPress 7.2 are available here</a>.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you encounter an issue, please share it in the <a href=\"https://wordpress.org/support/forum/alphabeta/\" rel=\"noopener\" target=\"_blank\">Alpha/Beta area</a> of the support forums. If you are comfortable submitting a reproducible bug report, you can do so <a href=\"https://core.trac.wordpress.org/newticket\" rel=\"noopener\" target=\"_blank\">via WordPress Trac</a>. You can also check your issue against this list of <a href=\"https://core.trac.wordpress.org/tickets/major\" rel=\"noopener\" target=\"_blank\">known bugs</a>.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Curious about testing releases in general and how to get started? Follow along with the <a href=\"https://make.wordpress.org/test/\">testing initiatives in Make Core</a> and join the <a href=\"https://wordpress.slack.com/messages/core-test/\">#core-test channel</a> on <a href=\"https://wordpress.slack.com/\">Making WordPress Slack</a>.</p>\n\n\n\n<h2 class=\"wp-block-heading\">A Beta 2 haiku</h2>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Second beta takes shape<br />New abilities take root<br />WordPress grows stronger</em></p>\n\n\n\n<p class=\"has-text-align-right wp-block-paragraph\"><em>Props to <a class=\"mention\" href=\"https://profiles.wordpress.org/mamaduka/\"><span class=\"mentions-prefix\">@</span>mamaduka</a> for pre-publish review</em>.</p>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Tue, 27 Oct 2026 15:49:21 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:14:\"David Baumwald\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:34;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:88:\"Open Channels FM: Open Source Debates AI, GridCraft Challenges Excel, Tesco Eyes Proxmox\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2565311\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:93:\"https://openchannels.fm/open-source-debates-ai-gridcraft-challenges-excel-tesco-eyes-proxmox/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:126:\"Reddit’s open source rules, a new Excel alternative, and Tesco considers open virtualization for retail edge infrastructure.\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Tue, 27 Oct 2026 15:15:00 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:8:\"Bob Dunn\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:35;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:71:\"Open Channels FM: Adapting to Local Client Needs in a Remote Work World\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2564786\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:78:\"https://openchannels.fm/adapting-to-local-client-needs-in-a-remote-work-world/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:104:\"A look at building business trust and reputation by combining local presence with digital communication.\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Tue, 27 Oct 2026 12:58:49 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:8:\"Bob Dunn\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:36;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:48:\"Akismet: Akismet turns 21. Spam isn’t invited.\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:28:\"http://akismet.com/?p=285509\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:60:\"https://akismet.com/blog/akismet-turns-21-spam-isnt-invited/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:5062:\"<p class=\"wp-block-paragraph\">On October 25, Akismet turns 21. We&#8217;re celebrating with a few new guests: an official Drupal module, a PHP SDK, and another year of improvements to our WordPress plugin. Spam still isn&#8217;t on the list.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Akismet <a href=\"https://ma.tt/2005/10/akismet-stops-spam/\">launched in October 2005</a> to help people spend less time dealing with comment spam and more time enjoying their blogs. The web has changed a lot since then. People build communities, collect inquiries, accept donations, and create applications on all kinds of platforms. Each of those places gives people a way to contribute. It also gives spammers somewhere to try their luck.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Since then, Akismet has blocked over 570 billion pieces of spam. Every one is something a site owner didn&#8217;t have to spend time sorting through. Our birthday wish is to keep making more room for the real people.</p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"welcome-drupal\">Welcome, Drupal</h3>\n\n\n\n<p class=\"wp-block-paragraph\">This year, we released the <a href=\"https://akismet.com/blog/introducing-the-official-akismet-drupal-module/\">official Akismet Drupal module</a>, built by the team behind Akismet. It brings our spam protection to Drupal comments, contact forms, webforms, and user registrations, with tools for moderators to review submissions and send corrections back to Akismet.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We&#8217;ve continued building on that welcome. The latest release <a href=\"https://akismet.com/blog/akismet-now-supports-drupal-12/\">supports Drupal 12</a> and passes richer bot-detection signals into spam scoring. On Drupal 12, comments and registrations are supported now; contact forms, webforms, and the Key module will follow as those modules become ready for Drupal 12.</p>\n\n\n\n<p class=\"wp-block-paragraph\">For people using the older community module, we also built an <a href=\"https://akismet.com/blog/upgrade-to-the-official-akismet-drupal-module/\">upgrade path to the official module</a> that carries their API key and protection settings across. The migration guide explains the requirements and which settings need attention.</p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"welcome-php-developers\">Welcome, PHP developers</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Akismet&#8217;s API has long made it possible to protect sites beyond WordPress. This year&#8217;s <a href=\"https://akismet.com/blog/introducing-the-official-akismet-php-sdk/\">official PHP SDK</a> gives developers a first-party client for bringing that protection into their own PHP applications, including projects built with Laravel or Symfony.</p>\n\n\n\n<p class=\"wp-block-paragraph\">The SDK handles the Akismet API integration so developers can focus on their application. It supports checking submissions, reporting spam and legitimate content, and retrieving usage and account information. The official Drupal module uses it too.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you&#8217;re building a place where people can post, sign up, or send a message, there&#8217;s a new tool to help you keep the spam out.</p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"a-familiar-guest-with-a-few-improvements\">A familiar guest, with a few improvements</h3>\n\n\n\n<p class=\"wp-block-paragraph\">WordPress has been with us from the beginning. This year, we kept improving that experience: clearer setup and error messages, accessibility improvements, better detection of automated submissions, and compatibility fixes. You can find the details in the <a href=\"https://wordpress.org/plugins/akismet/#developers\">WordPress plugin release log</a>.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://akismet.com/blog/akismet-v5-7-ready-for-abilities-and-connectors/\">Version 5.7 also added support for Abilities and Connectors</a>, helping Akismet fit into WordPress&#8217;s evolving tools for integrating external services.</p>\n\n\n\n<h3 class=\"wp-block-heading\" id=\"more-room-for-real-people\">More room for real people</h3>\n\n\n\n<p class=\"wp-block-paragraph\">A comment worth replying to. A message from a future customer. A donation to a cause someone cares about. Those are the things we want coming through.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Thank you to everyone who uses Akismet, builds an integration, reports a problem, or helps us improve. You&#8217;ve been part of these 21 years, and you&#8217;re very much invited to the celebration.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Whether your site runs on <a href=\"https://wordpress.org/plugins/akismet/\">WordPress</a>, <a href=\"https://akismet.com/blog/introducing-the-official-akismet-drupal-module/\">Drupal</a>, or something you&#8217;re building yourself with the <a href=\"https://akismet.com/blog/introducing-the-official-akismet-php-sdk/\">PHP SDK</a>, there&#8217;s room at the table.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Just no room for spam.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://www.drupal.org/project/akismet_antispam\">Try out the Drupal module today!</a></p>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Mon, 26 Oct 2026 15:16:26 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:14:\"Peter Westwood\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:37;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:74:\"Open Channels FM: AI in Cybersecurity: Balancing Speed and Human Oversight\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2564606\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:80:\"https://openchannels.fm/ai-in-cybersecurity-balancing-speed-and-human-oversight/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:249:\"As AI revolutionizes cybersecurity, organizations struggle with rapid vulnerability detection versus slow human remediation. Balancing efficiency and accountability is crucial, as maintaining human oversight prevents potentially catastrophic errors.\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Mon, 26 Oct 2026 11:35:00 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:16:\"Open Channels FM\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:38;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:110:\"Gutenberg Times: A critical PHP fix, WordPress 7.2 Beta 1, Notes in the margin, and more—Weekend Edition 378\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:35:\"https://gutenbergtimes.com/?p=47314\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:116:\"https://gutenbergtimes.com/a-critical-php-fix-wordpress-7-2-beta-1-notes-in-the-margin-and-more-weekend-edition-378/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:31285:\"<p class=\"wp-block-paragraph\">Howdy,</p>\n\n\n\n<p class=\"wp-block-paragraph\">Before anything else: check which version of PHP your sites run. On October 21, the PHP project <a href=\"https://wordpress.org/news/2026/10/critical-php-security-release/\"><strong>released fixes for two critical vulnerabilities</strong></a>, and they affect any server running a PHP application, not only WordPress. You&#8217;ll find your version under <strong>Tools → Site Health → Info → Server</strong> in your WordPress admin. If you manage your own server and are still on a version older than 8.2, I highly recommend updating. While many hosts have patched older PHP versions that are end of life, it’s best to stay on versions that PHP officially supports.</p>\n\n\n\n<p class=\"wp-block-paragraph\">On a happier note, I&#8217;m back. I was sick for a stretch earlier this month, which is why there was no edition on October 10. Rather than try to cram four weeks into one post, this edition sticks to the last two. Much of what happened in the gap is covered in my October roundup for developers, linked below.</p>\n\n\n\n<p class=\"wp-block-paragraph\">With that, let&#8217;s get down to the latest news.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Your friendly neighborhood developer advocate, <img alt=\"🎃\" class=\"wp-smiley\" src=\"https://s.w.org/images/core/emoji/17.0.2/72x72/1f383.png\" style=\"height: 1em;\" /><br /><em>Justin Tadlock</em></p>\n\n\n<div class=\"wp-block-newsletterglue-showhide ng-block\" width=\"100%\">\n<div class=\"wp-block-group has-accent-5-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-b14348ac wp-block-group-is-layout-constrained\">\n<p class=\"wp-block-paragraph\"><strong>Table of Contents</strong></p>\n\n\n<nav class=\"wp-block-table-of-contents\"><ul><li><a class=\"wp-block-table-of-contents__entry\" href=\"https://gutenbergtimes.com/feed/#0-word-press-release-information\">Developing Gutenberg and WordPress</a></li><li><a class=\"wp-block-table-of-contents__entry\" href=\"https://gutenbergtimes.com/feed/#0-p\">Plugins, Themes, and Tools for #nocode site builders and owners</a></li><li><a class=\"wp-block-table-of-contents__entry\" href=\"https://gutenbergtimes.com/feed/#2-word-press-6-0-1-and-6-1-scheduled\">Theme Development for Full Site Editing and Blocks</a></li><li><a class=\"wp-block-table-of-contents__entry\" href=\"https://gutenbergtimes.com/feed/#3-building-themes-for-fse-and-word-press\">Building Blocks and Tools for the Block editor.</a></li><li><a class=\"wp-block-table-of-contents__entry\" href=\"https://gutenbergtimes.com/feed/#what-s-new-in-playground\">What&#039;s new in Playground?</a></li><li><a class=\"wp-block-table-of-contents__entry\" href=\"https://gutenbergtimes.com/feed/#ai-in-wordpress\">AI in WordPress</a></li></ul></nav></div>\n</div>\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<h2 class=\"wp-block-heading\" id=\"0-word-press-release-information\">Developing Gutenberg and WordPress</h2>\n\n\n\n<p class=\"wp-block-paragraph\">The final major release of the year has entered testing. <strong>David Baumwald</strong> announced that <a href=\"https://wordpress.org/news/2026/10/wordpress-7-2-beta-1-is-ready-for-download-and-testing/\"><strong>WordPress 7.2 Beta 1 is ready for download and testing</strong></a>, with the final release set for December 8. Notes move into a margin beside the canvas and pick up emoji reactions. Text shadows and form element styling arrive in the design tools, a new Secrets API gives plugins a standard place to store API keys, and client-side media processing extends to the Media Library. There&#8217;s even an <strong>On This Day</strong> dashboard widget. Not everything made it, though: The Repository reports that <a href=\"https://www.therepository.email/wordpress-7-2-beta-1-out-now-with-secrets-api-and-notes-upgrades-punts-suggestion-mode-to-7-3\"><strong>Notes suggestion mode was punted to 7.3</strong></a>.</p>\n\n\n\n<p class=\"wp-block-paragraph\">The quickest way to try it is the 7.2 Beta 1 <a href=\"https://playground.wordpress.net/?php=8.3&amp;wp=beta&amp;language=&amp;multisite=no\">Playground instance</a>, or <code>wp core update --version=7.2-beta1</code> on a test site. Not on production.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Not sure where to start? <strong>Noruzzaman&#8217;s</strong> <a href=\"https://make.wordpress.org/test/2026/10/20/help-test-wordpress-7-2/\"><strong>Help Test WordPress 7.2</strong></a> breaks the release down by area: security, collaboration, admin, blocks and APIs, design, media. It also walks through the different ways to run a beta, from Playground to a staging site on your host, and points you to where feedback goes. The Beta 1 post is clear that testing counts as contributing, whether or not you&#8217;ve done it before.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Your first contribution to WordPress shouldn’t start with installing Git, Node.js, npm, and Docker. That’s the friction the WordPress Contributor Toolkit removes, and <strong>Ryan Welcher</strong> announced <a href=\"https://make.wordpress.org/core/2026/10/23/wordpress-contributor-toolkit-2-0-a-redesigned-app-in-your-language/\"><strong>Contributor Toolkit 2.0, a redesigned app in your language</strong></a>. It’s rebuilt on the WordPress Design System, ships in ten languages, and adds a settings dialog. After you apply a patch, you can revert a single file without losing the patch itself. It’s also about 350 MB smaller, which helps when a whole Contributor Day room downloads it at once.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Jorge Costa</strong> shared <a href=\"https://make.wordpress.org/core/2026/10/14/whats-new-in-gutenberg-24-2-14-october/\"><strong>what&#8217;s new in Gutenberg 24.2</strong></a>, and the Notes feature is the big headline. Notes now float in a margin the editor reserves next to the canvas, so you no longer have to choose between reading feedback and keeping the Settings sidebar open. </p>\n\n\n\n<figure class=\"wp-block-image size-full has-custom-border\"><img alt=\"Screenshot of the WordPress post editor with notes shown in the margin to the right.\" class=\"has-border-color has-steel-500-border-color wp-image-47316\" height=\"1469\" src=\"https://i0.wp.com/gutenbergtimes.com/wp-content/uploads/2026/10/gutenberg-notes-cropped.webp?resize=2048%2C1469&#038;ssl=1\" style=\"border-width: 1px;\" width=\"2048\" /></figure>\n\n\n\n<p class=\"wp-block-paragraph\">The Navigation block&#8217;s link search now looks through pages, posts, categories, and tags at once. Gallery can sort hand-picked images and tint all of them with a single duotone. And the design tools push continues with about 80 more PRs. Minimum width and height controls, for example, went from five blocks to 40. </p>\n\n\n\n<p class=\"wp-block-paragraph\">For developers, React 19 is now on by default. Test your plugins and themes, and if something breaks, you can switch it off under <strong>Gutenberg → Experiments</strong>. Gutenberg 24.3 RC1 is already out, too, with rich text formatting across blocks, so expect that next week.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">On the Developer Blog, I put together <a href=\"https://developer.wordpress.org/news/2026/10/whats-new-for-developers-october-2026/\"><strong>What&#8217;s new for developers? (October 2026)</strong></a>, and I tried something different this month. Instead of walking through every aspect of the project, it focuses on the changes I think matter most if you build on WordPress: custom blocks building their own responsive controls, <code>wp_kses()</code> being rebuilt on the HTML API, stroke-based Core icons, and the automated security review for plugin releases. Everything else is linked at the end.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Readers may remember <strong>Chris Zarate&#8217;s</strong> post on moving collaboration to the server from the last edition. <strong>Alec Geatches</strong> follows it up with <a href=\"https://make.wordpress.org/core/2026/10/14/real-time-collaboration-a-guide-to-sync-engines/\"><strong>a guide to the sync engines for real-time collaboration</strong></a>, comparing yjs-server, DE-RTC, and intent-log on their strengths and weaknesses. In every engine, each change goes through WordPress, which confirms who sent it, checks their permissions, and validates it before merging. You can try all three in the experimental <a href=\"https://github.com/WordPress/gutenberg-sync-engines\">Gutenberg Sync Engines</a> plugin. It needs WordPress 7.0+ and the <a href=\"https://wordpress.org/plugins/presence-api/\">Presence API plugin</a>, and it bundles its own copy of Gutenberg, so deactivate the Gutenberg plugin first.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Feature Notifications has been quiet since version 0.2.0 shipped in April 2023. <strong>Jonathan Bossenger</strong> is reviving it with a <a href=\"https://make.wordpress.org/core/2026/10/10/feature-notifications-status-update-and-plan-for-0-3-0/\"><strong>status update and plan for 0.3.0</strong></a>, aiming to ship it with WordPress. That would be the project&#8217;s first working MVP: a notifications system that creates, stores, displays, and dismisses notifications. His honest assessment is that the foundations are solid but nothing is wired up end to end yet. He&#8217;s posting <a href=\"https://make.wordpress.org/core/2026/10/23/wp-feature-notifications-weekly-update-2026-10-23/\"><strong>weekly updates</strong></a> if you want to follow along or help.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Benjamin Zekavica</strong> published the <a href=\"https://make.wordpress.org/core/2026/10/19/recap-wordpress-7-1-mary-lou-retrospective/\"><strong>recap of the WordPress 7.1 &#8220;Mary Lou&#8221; retrospective</strong></a>, summarizing what contributors would keep, add, and change for future release squads. If you answered the survey, this is where your feedback landed.</p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"0-p\">Plugins, Themes, and Tools for #nocode site builders and owners</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Sticky headers are one of those things you end up fixing on nearly every block theme site. <strong>Jamie Marsland</strong> turned his fix into a free plugin, <a href=\"https://www.pootlepress.com/2026/10/jamies-header-effects-free-sticky-header-plugin/\"><strong>Jamie&#8217;s Header Effects</strong></a>.</p>\n\n\n<div class=\"wp-block-newsletterglue-showhide ng-block\" width=\"100%\">\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n\n</div></figure>\n</div>\n\n\n<p class=\"wp-block-paragraph\">The standout is Chameleon mode: as visitors scroll, the header picks up the background color of the section beneath it and flips its text between light and dark to stay readable. There are also frosted-glass, solid, hide-on-scroll, and transparent overlay styles. It finds your header template part on its own, respects prefers-reduced-motion, and lives under <strong>Appearance → Header Effects</strong>.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Meta Box&#8217;s custom models no longer have to sit in isolation. A few weeks after moving model creation into the builder, <strong>Lua Nguyen</strong> announced <a href=\"https://metabox.io/custom-model-field/\"><strong>the new Custom Model field</strong></a>, which lets you pick one or more items from a custom model the same way the Post field picks posts. MB Relationships also gains a Model object type, so you can connect models to posts, terms, users, or other models in either direction. Think hotel rooms as a post type with bookings attached from a custom model—no IDs stored by hand.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">On WordPress.com, <strong>Ronnie Burt</strong> covers <a href=\"https://wordpress.com/blog/2026/10/15/wordpress-agent-updates/\"><strong>what&#8217;s new with WordPress Agent</strong></a>: it now designs a custom theme from your answers, hands you off to a simplified AI Editor with Preview and Edit tabs, and can install and manage plugins when you ask. The latest <a href=\"https://wordpress.com/blog/2026/10/16/changelog-premium-themes-newsletters/\"><strong>WordPress.com changelog</strong></a> also opens premium themes to every paid plan, starting with Personal.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://developer.woocommerce.com/2026/10/09/woocommerce-11-2-1-release-notes/\"><strong>WooCommerce 11.2.1</strong></a> fixes two regressions: classic checkout on stores that remove address fields with filters, and postcode validation in the Checkout block for Argentina and a few other countries.</p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"2-word-press-6-0-1-and-6-1-scheduled\">Theme Development for Full Site Editing and Blocks</h2>\n\n\n\n<p class=\"wp-block-paragraph\">If you&#8217;ve ever had to explain to a client why they should move to a block theme, <strong>Simon Cooke</strong> has done the work for you. His Human Made guide on <a href=\"https://humanmade.com/full-site-editing/wordpress-fse-block-theme-explained/\"><strong>how a WordPress block theme is built, and why it matters for enterprise sites</strong></a> walks through each part of a block theme and who owns it, with a side-by-side comparison to classic themes. He&#8217;s clear that moving is a project, not a theme swap. The point he lands on: when design rules live in the theme, a page built by someone who joined last week follows the same rules as one the designer built.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">What if you could point a tool at any static HTML and CSS site and get an editable block theme back, headers and footers included? That&#8217;s the Static Site Importer, and <strong>Chris Huber</strong> of Automattic talks it through with <strong>Nathan Wrigley</strong> on WP Tavern in <a href=\"https://wptavern.com/podcast/238-chris-huber-on-how-static-site-importer-makes-migrating-any-website-to-wordpress-easier-than-ever/\"><strong>episode #238 on making migration to WordPress easier than ever</strong></a>. You&#8217;ll hear how it crawls a site, maps HTML elements to blocks, and handles trickier features like WooCommerce, plus how it fits into the broader Data Liberation effort.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">WooCommerce&#8217;s Purple theme has a new home. <strong>Luigi Teschio</strong> announced that <a href=\"https://developer.woocommerce.com/2026/10/20/purple-monorepo/\"><strong>Purple development moves to the WooCommerce monorepo</strong></a>, as the first theme in its new themes/ directory, so contributions and bug reports go there now. One of the stated reasons is that keeping themes next to the blocks they use makes it easier for contributors, and AI coding tools, to see how templates and patterns use WooCommerce blocks. Nothing changes for existing installs, and Purple still releases on its own schedule. For more background, <strong>Bob Dunn&#8217;s</strong> Do the Woo episode on <a href=\"https://dothewoo.com/2026/10/15/woocommerce-themes-in-2026-woo-goes-purple-commercegurus-talks-performance/\"><strong>WooCommerce themes in 2026</strong></a> covers Purple and theme performance.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n<table cellpadding=\"0\" cellspacing=\"0\" class=\"ng-block-e68536f5b223273c wp-block-newsletterglue-container ng-block\" style=\"color: #666666;\" width=\"100%\">\n<tbody>\n<tr>\n<td class=\"ng-block-vs ng-block-vs-1\" colspan=\"3\" height=\"0\" style=\"height: 0px;\"></td>\n</tr>\n<tr>\n<td class=\"ng-block-hs ng-block-hs-1\" height=\"0\" style=\"width: 0px;\"></td>\n<td align=\"none\" class=\"ng-block-td\" style=\"font-size: 16px; font-family: Helvetica; line-height: 1.6; font-weight: normal; padding-top: 20px; padding-bottom: 20px; padding-left: 0px; padding-right: 0px; text-align: none; color: #666666; background-color: #fdfcea; border-radius: 12px;\">\n<table cellpadding=\"0\" cellspacing=\"0\" class=\"wp-block-newsletterglue-text ng-block\" style=\"color: #666666;\" width=\"100%\">\n<tbody>\n<tr>\n<td align=\"none\" class=\"ng-block-td\" style=\"font-size: 16px; font-family: Helvetica; line-height: 1.6; font-weight: normal; padding-top: 8px; padding-bottom: 10px; padding-left: 20px; padding-right: 20px; text-align: none; color: #666666;\">\n<p><strong> <a href=\"https://make.wordpress.org/core/handbook/references/keeping-up-with-gutenberg-index/\" rel=\"noreferrer noopener\" target=\"_blank\">&#8220;Keeping up with Gutenberg &#8211; Index 2026&#8221;</a> </strong><br />A chronological list of the WordPress Make Blog posts from various teams involved in Gutenberg development: Design, Theme Review Team, Core Editor, Core JS, Core CSS, Test, and Meta team from Jan. 2024 on. Updated by yours truly. </p>\n</td>\n</tr>\n</tbody>\n</table>\n<table cellpadding=\"0\" cellspacing=\"0\" class=\"wp-block-newsletterglue-text ng-block\" style=\"color: #666666;\" width=\"100%\">\n<tbody>\n<tr>\n<td align=\"none\" class=\"ng-block-td\" style=\"font-size: 16px; font-family: Helvetica; line-height: 1.6; font-weight: normal; padding-top: 8px; padding-bottom: 10px; padding-left: 20px; padding-right: 20px; text-align: none; color: #666666;\">\n<p>The previous years are also available: <br /><strong><strong><a href=\"https://make.wordpress.org/core/handbook/references/keeping-up-with-gutenberg-index/keeping-up-with-gutenberg-index-2020/\">2020</a> | <a href=\"https://make.wordpress.org/core/handbook/references/keeping-up-with-gutenberg-index/keeping-up-with-gutenberg-index-2021/\">2021</a></strong> | <strong><a href=\"https://make.wordpress.org/core/handbook/references/keeping-up-with-gutenberg-index/keeping-up-with-gutenberg-index-2022/\">2022</a></strong></strong> | <strong><a href=\"https://make.wordpress.org/core/handbook/references/keeping-up-with-gutenberg-index/gutenberg-index-2023\">2023</a></strong> | <a href=\"https://make.wordpress.org/core/handbook/references/keeping-up-with-gutenberg-index/gutenberg-index-2024/\"><strong>2024</strong></a> | <strong><a href=\"https://make.wordpress.org/core/handbook/references/keeping-up-with-gutenberg-index/gutenberg-index-2025/\">2025</a></strong></p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n<td class=\"ng-block-hs ng-block-hs-2\" height=\"0\" style=\"width: 0px;\"></td>\n</tr>\n<tr>\n<td class=\"ng-block-vs ng-block-vs-2\" colspan=\"3\" height=\"0\" style=\"height: 0px;\"></td>\n</tr>\n</tbody>\n</table>\n\n\n<h2 class=\"wp-block-heading\" id=\"3-building-themes-for-fse-and-word-press\">Building Blocks and Tools for the Block editor.</h2>\n\n\n\n<p class=\"wp-block-paragraph\">The new <code>@wordpress/ui</code> package will gradually replace <code>@wordpress/components</code>, so how much of an existing plugin can you move over today? <strong>Ryan Welcher</strong> found out live by <a href=\"https://www.youtube.com/watch?v=3MJUEC4PTa4\"><strong>migrating Advanced Query Loop to @wordpress/ui with the Design System MCP</strong></a>. </p>\n\n\n<div class=\"wp-block-newsletterglue-showhide ng-block\" width=\"100%\">\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n\n</div></figure>\n</div>\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Once your page registers WebMCP tools, those tool definitions are an API, and the consumer is a language model. <strong>Pascal Birchler</strong> built <a href=\"https://pascalbirchler.com/testing-webmcp-with-playwright/\"><strong>playwright-webmcp for testing WebMCP tool surfaces</strong></a>, with linting, Playwright matchers, agent evals, and a site audit CLI. He lists the failure modes that make this tricky: vague descriptions the model ignores, schemas the browser quietly rejects, and two tools on the same page with nearly identical names.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Extension developers no longer need to duplicate a WooCommerce ability just to expose a few extra fields. <strong>Luis Felipe Zaguini</strong> opened a <a href=\"https://developer.woocommerce.com/2026/10/22/extensible-abilities/\"><strong>call for testing extensible abilities for extension fields</strong></a>, an experimental API in WooCommerce 11.3. Extensions can add fields to product, order, and order item reads and writes, register query filters, and refuse a change with a validator before it saves. It&#8217;s off by default, so turn on <strong>Extensible abilities</strong> under <strong>WooCommerce → Settings → Advanced → Features</strong> to try it. The gift wrap example in the post is a good place to start.</p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"what-s-new-in-playground\"><strong>What&#8217;s new in Playground?</strong></h2>\n\n\n\n<p class=\"wp-block-paragraph\">The best way to find out what&#8217;s hard about site editing is to watch someone try it. <strong>Jamie Marsland</strong> built <a href=\"https://www.pootlepress.com/2026/10/new-wordpress-user-testing-app-playground-spacefast/\"><strong>a user testing app</strong></a> <strong>for</strong> <a href=\"https://playground-usertest.view.fast/\"><strong>WordPress on Playground and Spacefast</strong></a> to do exactly that. You send a tester a link, and Playground spins up a fresh site in their browser from your existing demo blueprint, with a card of five to seven tasks in the corner. The results page shows how long each task took, who needed the hint, and whether the site actually changed. It&#8217;s also an MCP server, and it&#8217;ll flag a task that gives away the button name.</p>\n\n\n\n<h2 class=\"wp-block-heading\" id=\"ai-in-wordpress\"><strong>AI in WordPress</strong></h2>\n\n\n\n<p class=\"wp-block-paragraph\">Two weeks after the MCP Adapter arrived on WordPress.org as a canonical plugin, the AI team got approval to make MCP a default part of WordPress. <strong>Rae Morey</strong> reports on <a href=\"https://www.therepository.email/wordpress-ai-team-moves-to-make-mcp-a-default-part-of-wordpress-with-7-3-floated-as-a-target\"><strong>the move to make MCP a default part of WordPress, with 7.3 floated as a target</strong></a>. That doesn&#8217;t necessarily mean merging the adapter into Core: bundling it, enabling it through existing interfaces, and building specific capabilities into Core are all on the table. It&#8217;s also a reversal of the reasoning behind the canonical plugin, and maintainers are asking what changed. The <a href=\"https://make.wordpress.org/ai/2026/10/22/ai-contributor-weekly-summary-21-october-2026/\"><strong>AI contributor summary for October 21</strong></a> has the meeting&#8217;s side of the discussion.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Andy Peatling</strong> launched <a href=\"https://wpab.view.fast/\"><strong>WordPress Agent Benchmarks</strong></a> to measure how AI agents handle WordPress, and <strong>Rae Morey</strong> walks through <a href=\"https://www.therepository.email/new-benchmarks-find-ai-agents-overlook-wordpress-and-cant-complete-tasks-via-the-official-mcp-adapter\"><strong>the first results</strong></a>. Across 193 sites built for requests that suited WordPress, agents chose it zero times, even though they named it as an option about half the time. Using the MCP Adapter alone, they completed no tasks on existing sites, largely because it doesn&#8217;t yet bundle the abilities for common operations. <strong>Brian Coords</strong> asks what WordPress would have to change in <a href=\"https://www.briancoords.com/helping-agents-choose-wordpress-w-the-wp-minute/\"><strong>helping agents choose WordPress</strong></a>, drawing on a WP Minute panel with Andy.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Is the MCP Adapter safe? <strong>Brad Williams</strong> of WebDevStudios calls it a door: &#8220;You decide which rooms it opens into.&#8221; He explains why <a href=\"https://webdevstudios.com/2026/10/15/wordpress-mcp-adapter-production/\"><strong>production use of the MCP Adapter is a governance decision</strong></a>, not a plugin decision. An agent gets whatever abilities are exposed, using the permissions of the user it connects as, and every plugin you install can add more. His advice is to write the agent&#8217;s job description before you hand over the keys.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">If you connect an AI client to WooCommerce, this one needs action before you upgrade. <strong>Darren Ethier</strong> explains that <a href=\"https://developer.woocommerce.com/2026/10/21/woocommerce-11-3-mcp/\"><strong>WooCommerce 11.3 removes its deprecated MCP endpoint</strong></a>. Requests to /wp-json/woocommerce/mcp will return a 410. Install the MCP Adapter, create an application password for a user with only the capabilities the client needs, and point the client at the adapter&#8217;s default server. Extensions that hooked into the old endpoint&#8217;s filters should check the post&#8217;s full list of what&#8217;s been removed.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">WPShout&#8217;s guide on <a href=\"https://wpshout.com/connect-claude-to-wordpress/\"><strong>how to connect Claude to WordPress</strong></a> opens with the question most guides skip: where your site is hosted decides which route you take. WordPress.com, Jetpack, and other self-hosted sites each get their own path, and the walkthrough uses a free MCP plugin with a least-privilege grant. It&#8217;s also candid about a gap: the WordPress MCP Adapter has no OAuth server of its own, so claude.ai&#8217;s sign-in can&#8217;t connect to it directly yet.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"wp-block-paragraph\">Post revisions spent years bloating databases. Human Made thinks they&#8217;re about to become valuable. In <a href=\"https://humanmade.com/word-on-the-future/agentic-wordpress-revisions-process-mining/\"><strong>WordPress revisions: agentic gold?</strong></a>, <strong>Noel</strong> argues that every revision records what changed, who changed it, and when, which makes them a log of how your team really works. Mine them for repeated changes and you&#8217;ve found the workflows an agent could take over. The post includes a prompt you can run, on a copy of your database and never on production.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n<table cellpadding=\"0\" cellspacing=\"0\" class=\"ng-block-1b9e58c3f62d1691 wp-block-newsletterglue-container ng-block\" style=\"color: #666666;\" width=\"100%\">\n<tbody>\n<tr>\n<td class=\"ng-block-vs ng-block-vs-1\" colspan=\"3\" height=\"0\" style=\"height: 0px;\"></td>\n</tr>\n<tr>\n<td class=\"ng-block-hs ng-block-hs-1\" height=\"0\" style=\"width: 0px;\"></td>\n<td align=\"none\" class=\"ng-block-td\" style=\"font-size: 16px; font-family: Helvetica; line-height: 1.6; font-weight: normal; padding-top: 20px; padding-bottom: 20px; padding-left: 0px; padding-right: 0px; text-align: none; color: #666666; background-color: #f8f8f8; border-radius: 8px;\">\n<table cellpadding=\"0\" cellspacing=\"0\" class=\"wp-block-newsletterglue-text ng-block\" style=\"color: #666666;\" width=\"100%\">\n<tbody>\n<tr>\n<td align=\"none\" class=\"ng-block-td\" style=\"font-size: 16px; font-family: Helvetica; line-height: 1.6; font-weight: normal; padding-top: 8px; padding-bottom: 10px; padding-left: 20px; padding-right: 20px; text-align: none; color: #666666;\">\n<p><strong><a href=\"https://gutenbergtimes.com/need-a-zip-from-master/\">Need a plugin .zip from Gutenberg&#8217;s master branch?</a></strong><br />Gutenberg Times provides daily build for testing and review.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<table cellpadding=\"0\" cellspacing=\"0\" class=\"wp-block-newsletterglue-image ng-block size-full is-resized\" width=\"100%\">\n<tbody>\n<tr>\n<td align=\"center\" class=\"ng-block-td\" style=\"padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px;\"><a href=\"https://playground.wordpress.net/?blueprint-url=https://gutenbergtimes.com/wp-content/uploads/2020/11/playnightly.json\"><img alt=\"\" class=\"wp-image-42874 ng-image\" height=\"45\" src=\"https://i0.wp.com/gutenbergtimes.com/wp-content/uploads/2024/02/Screenshot-2025-11-15-at-12.06.44.png?resize=196%2C45&#038;ssl=1\" style=\"border-style: none; border-color: transparent;\" width=\"196\" /></a></td>\n</tr>\n</tbody>\n</table>\n<table cellpadding=\"0\" cellspacing=\"0\" class=\"wp-block-newsletterglue-text ng-block\" style=\"color: #666666;\" width=\"100%\">\n<tbody>\n<tr>\n<td align=\"none\" class=\"ng-block-td\" style=\"font-size: 16px; font-family: Helvetica; line-height: 1.6; font-weight: normal; padding-top: 8px; padding-bottom: 10px; padding-left: 20px; padding-right: 20px; text-align: none; color: #666666;\">\n<p>Now also available via <a href=\"https://playground.wordpress.net/?blueprint-url=https://gutenbergtimes.com/wp-content/uploads/2020/11/playnightly.json\">WordPress Playground</a>. There is no need for a test site locally or on a server. Have you been using it? <a href=\"mailto:pauli@gutenbergtimes.com\">Email me </a>with your experience.</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n<td class=\"ng-block-hs ng-block-hs-2\" height=\"0\" style=\"width: 0px;\"></td>\n</tr>\n<tr>\n<td class=\"ng-block-vs ng-block-vs-2\" colspan=\"3\" height=\"0\" style=\"height: 0px;\"></td>\n</tr>\n</tbody>\n</table>\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide is-style-wide--3\" />\n\n\n\n<p class=\"has-text-align-center has-small-font-size wp-block-paragraph\"><em>Questions? Suggestions? Ideas? </em><br /><em>Don&#8217;t hesitate to send <a href=\"mailto:pauli@gutenbergtimes.com\">them via email</a> or</em><br /><em> send me a message on WordPress Slack or Twitter @bph</em>.</p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" />\n\n\n\n<p class=\"has-text-align-center has-small-font-size wp-block-paragraph\">For questions to be answered on the <a href=\"http://gutenbergtimes.com/podcast\">Gutenberg Changelog</a>, <br />send them to <a href=\"mailto:changelog@gutenbergtimes.com\">changelog@gutenbergtimes.com</a></p>\n\n\n<div class=\"ng-block-aa502119bf1b6e53 wp-block-newsletterglue-separator ng-block\" style=\"color: #666666;\" width=\"100%\"><div><div><div align=\"center\" class=\"ng-block-td\" style=\"padding-top: 20px; padding-bottom: 20px; padding-left: 20px; padding-right: 20px; color: #666666;\"><hr style=\"background-color: transparent; color: transparent; margin: 0; border: 0; border-top: 1px solid #666666; width: 560px; height: 0;\" /></div></div></div></div>\n\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide is-style-wide--4\" />\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Sat, 24 Oct 2026 16:18:33 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:14:\"Justin Tadlock\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}