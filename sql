{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2566530\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:132:\"https://openchannels.fm/postgres-faces-ai-discovered-bugs-ubuntu-critiqued-for-patching-and-ochaken-why-you-should-archive-websites/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:115:\"Postgres struggles with AI-found bugs, Ubuntu\'s patch speed is questioned, and a cherished web fan site disappears.\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Wed, 04 Nov 2026 15:00:26 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:8:\"Bob Dunn\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:16;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:113:\"WPTavern: #240 – Martin Schmidt on Building Partnerships Between WordPress Product Makers and Hosting Companies\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:48:\"https://wptavern.com/?post_type=podcast&p=209574\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:128:\"https://wptavern.com/podcast/240-martin-schmidt-on-building-partnerships-between-wordpress-product-makers-and-hosting-companies/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:48384:\"<details>Transcript<div>\n<p class=\"wp-block-paragraph\">[00:00:19] <strong>Nathan Wrigley:</strong> Welcome to the Jukebox podcast from WP Tavern. My name is Nathan Wrigley.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Jukebox is a podcast which is dedicated to all things WordPress. The people, the events, the plugins, the blocks, the themes, and in this case, building partnerships between WordPress product makers and hosting companies.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you&#8217;d like to subscribe to the podcast, you can do that by searching for WP Tavern in your podcast player of choice, or by going to wptavern.com/feed/podcast, and you can copy that URL into most podcast players.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you have a topic that you&#8217;d like us to feature on the podcast, I&#8217;m keen to hear from you and hopefully get you, or your idea, featured on the show. Head to wptavern.com/contact/jukebox, and use the form there.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So on the podcast today we have Martin Schmidt.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Martin has been deeply involved in the WordPress and hosting industries since 2005 when he created his first WordPress travel blog while living in New Zealand. Over the years, he&#8217;s developed websites for small businesses, spent 13 years with IONOS in various management and strategy roles, and built partnerships at Wix, and a German SaaS company.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Most recently, Martin has focused on connecting WordPress plugin companies with web hosts, helping both sides unlock growth through smarter partnerships.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Today, the conversation focused on the often overlooked world of partnerships between plugin developers and hosting companies. Martin shares insights from his two decades of experience on why hosting providers are the perfect allies for WordPress product makers looking to grow, given their established relationships and marketing channels to large customer bases.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We talk about the curious fact that many plugin builders put enormous effort into their products, but stumble when it comes to sales, marketing, and building the business relationships necessary for broader success.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Martin discusses what hosting companies are actually looking for in a partnership, the technical and marketing preparations plugin makers should have ready, and why empathy and preparation make all the difference when trying to connect with busy product managers.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you&#8217;re a developer, freelancer, or agency owner interested in taking your WordPress product to the next level, or if you want a candid look at how partnerships really work in the open source ecosystem, this episode is for you.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you&#8217;re interested in finding out more, you can find all of the links in the show notes by heading to wptavern.com/podcast, where you&#8217;ll find all the other episodes as well.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And so without further delay, I bring you Martin Schmidt.</p>\n\n\n\n<p class=\"wp-block-paragraph\">I am joined on the podcast by Martin Schmidt. Hello Martin.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:14] <strong>Martin Schmidt:</strong> Hi, Nathan. Great to be here.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:16] <strong>Nathan Wrigley:</strong> Yeah, thank you. Martin and I do not know one another, so this is our first call, but we were joined together, on maybe LinkedIn. I&#8217;m not entirely sure.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:23] <strong>Martin Schmidt:</strong> I was LinkedIn. Yeah. Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:25] <strong>Nathan Wrigley:</strong> Probably LinkedIn, by Nicole, so thank you to Nicole for doing that, really appreciate the linking together there. And we&#8217;re going to have a conversation today about, I suppose the word to describe it would be partnerships. How to partner with various different entities, possibly hosting companies are going to come up and things like that, so.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Before we begin that conversation, Martin are you able to just give us your little bio? Tell us a little bit about who you are and what you&#8217;ve done in the hosting partnership WordPress space, whatever you think fits best.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:03:55] <strong>Martin Schmidt:</strong> Yes, absolutely. I&#8217;m from Germany. I lived down south in Karlsruhe. Originally from the Cologne area. Started working with WordPress actually in I think 2005, something like that. When I was moving to New Zealand and started studying in New Zealand. That&#8217;s when I spun up my first WordPress site as a travel blog. And this was my first contact with WordPress. So I think, yeah, one of the, not one of the first users, but one of the very early.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:04:20] <strong>Nathan Wrigley:</strong> Fairly early, yeah, pretty early.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:04:22] <strong>Martin Schmidt:</strong> Very early. So that&#8217;s when you still had to like download WordPress and upload it via FTP, and there was no like auto update in the WordPress admin, and stuff like that. So one of the very early users and.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Yeah, around that time, that&#8217;s also how I got in touch with like the whole hosting industry. I was a web developer myself, started in high school developing websites for small businesses. Built them for people here in Germany and then also in New Zealand while I was studying over there.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And when I got back from New Zealand, I started applying for jobs. And one was with Google, the other one was with Ionos. And Ionos answered I think within a week, and I&#8217;m still waiting for the answer from Google till today. So, they never really got back to me, but yeah, it&#8217;s somewhere in the mail, yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But luckily the guys from Ionos got back to me and I think a week later I had a phone interview. Another four days later an interview in Karlsruhe. And then I started, I think two weeks later. Already started there like end of October with my first job as a product manager at Ionos.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And then spent 13 years at Ionos in various roles, in product management and the last five years in strategy. And from there I got the chance to move on to Wix. Worked for Wix.com in Germany. There was, during the COVID pandemic, I moved employers and started to work for Wix, and spent two years there building partnerships in, Europe.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Actually also put them in touch with a company called Sevdesk, which is a German accounting company, similar to Zero or QuickBooks Online. And couple of months later the CEO asked me if I was interested in joining their side, after they had raised some money and built partnerships from their side. I kept him waiting a little bit, but then after a while I decided, that&#8217;s interesting to join a German SaaS company. Something different than hosting, and online presence.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So yeah, I spent the next two years building the ecosystem around the SaaS software, like all the software that integrates with the accounting product basically.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Then end of 24, I got a call from my former boss from Ionos, who had just moved to hosting.com and became the CRO, and they also wanted to do partnerships. So, yeah, had a chat with him and with the CEO and started there in February 2025, and started building partnerships for hosting.com.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And, the main focus was really on building partnerships with WordPress companies. Just after Cloudfest, we launched the partnership with WP Rocket. Started to build quite a few more partnerships, or that were in the making. And by the end of the year, which was interesting to me, I had a lot of those WordPress plugin companies that I reached out to telling me, look, this is super interesting. We want to work with hosting companies.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We&#8217;re really glad to be working with you. We would also love to work with a lot of more hosting companies, but honestly we don&#8217;t really know where to start, and how to do this. And they really got me thinking. And then over New Years, and you know when you like, get some time to maybe reflect on the year and stuff that&#8217;s happening, this was like, it, really hit me. It&#8217;s like, well there&#8217;s so much interest of companies wanting to partner with web hosts.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And I&#8217;ve sat on the other side for some 20 years, like people pitching to me, like explaining me why their product is going to be the next big thing for me in the hosting company. And you start to see patterns of like things that people do good, and maybe things that people don&#8217;t do as well when like trying to pitch to you as a hosting company.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And I saw all this demand from these WordPress plugin companies and I was like, hey, maybe this is finally the idea of starting my own business. Like something I wanted to do for the last five years, but I never really had the idea of like what to do? Or not the idea that was convincing enough for myself to give up my corporate job.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And, once you got a house and family, I mean, it becomes a bit more difficult to just jump into the cold water, right? I guess a lot of people can relate to that. But this time it was different. I felt like this could really be something. So I started reaching out to more people in my network, and ask them, hey, I&#8217;m thinking about doing like this sort of consulting advisory thing. Do you think this is interesting? And I got a lot of positive feedback, way more than I had anticipated.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So I thought, okay, if I&#8217;m not doing this now, I will never do it. I will never try and do it. So yeah, I decided to go independent and officially started in May. And that&#8217;s what I&#8217;m doing now, like helping tech companies who want to partner with web hosts to find a way to do it.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And I always tell people that are interested in, you can do it by yourself, right? You can find it all out yourself. It&#8217;s probably going to take you like three to four years to figure out the right model, and make all the connections. Build the trust with the hosting companies. Find out the right business model. The right support model, like the co-marketing activities, all the things you need to do. Or if you don&#8217;t want to wait for four years, you can work with me and I help you take a shortcut.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And the goal is by month six that you have someone in your organisation who can take care of partnerships, and just run this by yourself. But you don&#8217;t make all of those mistakes, and all of those extra investments that don&#8217;t turn into anything.</p>\n\n\n\n<p class=\"wp-block-paragraph\">My pitch to my customers is like, I&#8217;m helping you cut down the time to market. I&#8217;m telling you what works and what doesn&#8217;t work, and what makes a good pitch.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:09:49] <strong>Nathan Wrigley:</strong> Yeah, this is genuinely really interesting to me, and we&#8217;ll get into that a little bit later. But I have a different angle to you, but probably we&#8217;ll end up at exactly the same place.</p>\n\n\n\n<p class=\"wp-block-paragraph\">I&#8217;ve been podcasting in the WordPress space for a decade. So 2016, something like that, I started. And, if you do podcasting often enough, your voice is heard, and people have this sort of expectation, if you send an email to me with a product that you&#8217;ve just launched, I will somehow have a silver bullet for making you successful.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And first thing to say is, I basically don&#8217;t. You know, I can put you on a podcast episode, but that really is the limits of what I can do.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But also what&#8217;s quite fascinating, and I honestly genuinely, I probably get about 30 or 40 of these emails a week. And the bit that stands out for me is how unprepared, let&#8217;s go for that word, how poorly prepared the email that I receive is.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So in many cases over the last couple of years, it&#8217;s clearly been written by an AI. There hasn&#8217;t been a lot of due diligence about who I am, so it kind of feels like this really, really cold call. I somehow got on an email list somehow. And it comes, you know, with all of the usual caveats. The first paragraph is telling me what I do, and I already know what I do. So like there was an AI in there somewhere.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But also it feels like they&#8217;ve got a product. Quite often I&#8217;ll go and look at the product and I think to myself, boy, that&#8217;s so good. Look at what they&#8217;ve done. Like they&#8217;ve built a plugin and it&#8217;s fulfilling a real need.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Unfortunately, I can&#8217;t really help them except put them on a podcast, but it occurs to me if only they could connect with all the right people, have the right language, know how to pitch themselves, know how their website should look so that it speaks to people that drop into it.</p>\n\n\n\n<p class=\"wp-block-paragraph\">What I&#8217;m basically trying to build up a picture is of is that there&#8217;s loads of people out there who are building things, but clearly the building of it is the part that they&#8217;ve been interested in. And as soon as it&#8217;s built, they then have this moment of, oh, now what do I do with it? You know? And they don&#8217;t have that marketing expertise, and so they&#8217;re kind of looking around trying podcasters and what have you. And it feels like you are trying to step into that gap a little bit.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But instead of it being a podcast, you are trying to hook them up to what are the big players in the WordPress space? The people with deep pockets. The people who have reliable income month over month. And that&#8217;s the hosting companies. Have I summarised that correctly? Is that your experience as well? You get people that have got a thing, but don&#8217;t really know how to move on from the I&#8217;ve built the thing, to now I need to sell the thing.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:12:37] <strong>Martin Schmidt:</strong> Yes. So I think you&#8217;re spot on. And I would add there&#8217;s probably, I would say two groups. There&#8217;s the one which is maybe the builder who doesn&#8217;t know marketing, right? And we had these people before AI that were building fantastic products. But they just don&#8217;t know marketing because they&#8217;re fantastic builders. They&#8217;re tech people, but they&#8217;re missing that marketing piece.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And the one thing they don&#8217;t hire a marketing person who does it for them. I think that&#8217;s always a shame. You see this fantastic product, someone like driving a product with their passion. They&#8217;re really solving a pain point, but they just don&#8217;t understand how to sell it. Because to them it&#8217;s all clear, it&#8217;s all obvious, but you do need to translate it to people in your target audience.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So I think this is one group, and I see that also a lot with WordPress plugin companies. It feels like, coming from the hosting space, where all of the big companies are so good at marketing. Looking at WordPress companies, I feel like this is really something that they are somewhat missing.</p>\n\n\n\n<p class=\"wp-block-paragraph\">I think the most successful WordPress plugin companies, I think that&#8217;s probably the ones that have understood that next to building fantastic product, and also needs fantastic marketing. But I think this is really the one group.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And the other one is, I would call them like lazy salespeople. They&#8217;re just sending out like sales messages. And we had them way before AI, just sending out without doing any research at all. You get messages and you look at them or you look at the product, it&#8217;s like, there&#8217;s no fit at all. I&#8217;m selling to small businesses, and you pitching me a product for enterprise customers. Like, why? You are just wasting time, right?</p>\n\n\n\n<p class=\"wp-block-paragraph\">If your goal is to work with a company to potentially sell to hundred, thousands, or millions of customers, and that&#8217;s going to be a deal worth hundred thousands or millions of dollars, you should invest maybe an hour, half an hour, of research and just see if there&#8217;s any fit at all right. And then if you take the time to go in a meeting with me and pitch your product, do a little bit of research to just make it fit. Just this tiny bit of research will make you stand out amongst the crowd like completely.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:14:41] <strong>Nathan Wrigley:</strong> It feels to me in the first case as if, timing&#8217;s not really the right word, but there&#8217;s a component of timing in here. And what I&#8217;m meaning by that is, what I&#8217;m feeling is that a lot of people have spent all of their time building the thing. So that might be time, but it might be money, whatever the thing that you&#8217;ve got going on in your business.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But at no point during the time from conception, idea to completed product have they said to themselves, okay, at some point we&#8217;re going to have to market this. We&#8217;re going to have to think about it.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So maybe, and I don&#8217;t know if this is part of the sort of wisdom that you have, but it feels like maybe halfway through that process of build to complete build, you need to put the brakes on and say, okay, now we&#8217;re halfway through, let&#8217;s work in two channels now. Let&#8217;s do the, finish the build, but also at the same time, let&#8217;s do the marketing.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So I don&#8217;t know if there&#8217;s anything in there, like just put on the brakes before you finish, have some resources, have some ideas of contacts, have some marketing, have a website and all of that kind of stuff done. So that when you finish, it&#8217;s all ready to roll.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:15:43] <strong>Martin Schmidt:</strong> Yes. That&#8217;s definitely it. I don&#8217;t know if you have to put on the brakes, but I think it&#8217;s like, at least you as the CEO, you have to like work on two tracks. There&#8217;s the guys building the product, but then there&#8217;s also the marketing piece of it, right?</p>\n\n\n\n<p class=\"wp-block-paragraph\">And you can have the most fantastic product if you&#8217;re not telling the story, if you&#8217;re not letting the world know. How are people going to find you, right? I think we see, I saw a stat on LinkedIn recently that there&#8217;s like a thousand plugins published on the repository every week. It&#8217;s going to be so crowded. You need to do something to stand out and to be found.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And I think that&#8217;s also with web hosts and every tech company, you can have the most amazing product, but if you&#8217;re not found, if the target audience doesn&#8217;t know about you, nobody will use your product. And you&#8217;re going to be the only user of your own product.</p>\n\n\n\n<p class=\"wp-block-paragraph\">I think in the end, you need to master marketing to be successful with your business. And it&#8217;s not just about the best product. And, I think that&#8217;s the important message here. You don&#8217;t need to know marketing yourself. Just hire someone. There&#8217;s so many people specialise in marketing. Just get someone on board who knows marketing and who understands a little bit of tech to get why your product is so special, and who&#8217;s able to translate that into a customer pain point, and figure out how to sell it. that&#8217;s really it.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:16:58] <strong>Nathan Wrigley:</strong> So we&#8217;ve done podcast episodes on this podcast before where we&#8217;ve talked about partnerships in a different way. We&#8217;ve talked about partnerships in terms of plugin Company A joining with plugin Company B, because they&#8217;ve got similar enough products that they kind of overlap, and they can help each other out and mutually market and do marketing campaigns together and things like that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But that&#8217;s not what we&#8217;re talking about here. We&#8217;re talking specifically about going to hosting companies. So I guess the first question is, why go to hosting companies? What is it that they bring? I suppose the obvious answer is they&#8217;ve got bajillions of customers. In many cases, you know, some of the big hosts, if you can forge some sort of relationship with them, goodness knows, you know, maybe they literally have millions of customers. But why have you made hosting companies the bit of the half of this jigsaw puzzle?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:17:45] <strong>Martin Schmidt:</strong> Yes. beside me coming from hosting and knowing hosting, which was kind of like, make it a bit easy to decide for hosters. But I think they also play an important role. In the end, if a small business wants to run a website, they need to host it somewhere. They decide for hosting company. They get their WordPress site spun up. And then, that&#8217;s where usually in the next step you would go with like certain plugins. Like for SEO, performance, backup, security, translations, whatever your use case is, right?</p>\n\n\n\n<p class=\"wp-block-paragraph\">As you mentioned, the hosting company is the one that has all of the relationships with the customers. And unlike the WordPress companies, who are not allowed by the repository rules to directly market to their customers via email and things like that, they can only use popups inside the WordPress admin.</p>\n\n\n\n<p class=\"wp-block-paragraph\">One thing that the host is free to do, they can call the customers, they can send text messages, they can send them emails. They can do all of the up and cross sell marketing to their customers. And I think that&#8217;s one advantage that the hoster has that they can bring to the table, beside all of these customer relationships, right? They can really do the full blown marketing to those free users, to push a premium version of the plugin.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:18:59] <strong>Nathan Wrigley:</strong> Okay. So it&#8217;s not just visibility within the platform of, I don&#8217;t know, you&#8217;re at the point of it installing a plugin because you&#8217;ve got a brand new WordPress website. And look, here&#8217;s a bunch of partners that we&#8217;ve got, you may be interested in those.</p>\n\n\n\n<p class=\"wp-block-paragraph\">That&#8217;s one piece of it. But there&#8217;s also this sort of marketing side. Presumably just like every company on earth, web hosting companies are as keen to keep front of mind as any other company. So if they can come up with a good, and I&#8217;m doing air quotes, excuse to send out an email, they&#8217;ll do that. And why not send out an email because we&#8217;ve onboarded a new partner and, you know, have you thought about doing this with your website? It turns out we&#8217;ve got a partnership with this particular plugin company.</p>\n\n\n\n<p class=\"wp-block-paragraph\">I&#8217;m guessing there that the ability to send out emails is something, you know, to keep front of mind is something that the web host would want to do. But what&#8217;s in it for the web host? Like if I was a plugin company coming to a web host, I would want to have in my mind, okay, these are the kind of things I know they&#8217;re looking for. What are they, what do the web hosts want in return?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:19:55] <strong>Martin Schmidt:</strong> Yeah. So a lot of web host will tell you, hey, I want new customers, and that&#8217;s what I usually tell the web hosts. This is something you can&#8217;t expect from the WordPress plugin company. Because they are like in the later stage of that decision process. So the customer decides for the plugin a lot later than they decide for the host. So it&#8217;s not fair to ask the plugin company to bring in new customers to the web host.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But what they can do and what the WordPress plugin company can help with is, A, make the product a lot more attractive. They&#8217;re web hosts that sell hosting bundled in with plugins like WP Rocket. So the product itself is more attractive from the get go.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And if you don&#8217;t bundle it in the start, you can also help solve certain customer pains that make the customer more happy, therefore more sticky, right? So you prevent churn. As a host, you reach like a hundred thousand, 200,000 customers. You really need to work hard that your new customer growth isn&#8217;t eaten up all by churn. Making your customers sticky and drive up the revenue per customer, that&#8217;s in the interest of the web host, right? And, with a certain size, increasing that revenue per customer also becomes very important and interesting for the web host.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So I think that&#8217;s where the plugin company can come in and help the web host. They won&#8217;t just partner with any plugin. The plugin needs to solve a certain pain point for the customer. So this could be performance, this could be SEO, this could be accessibility. So these are challenges that the customers of the web host are actually faced with. And the plugin is simply a solution to that pain point.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So the hoster has an answer to that question of their customer. They&#8217;re in the role of the trusted advisor to their customers. And if the customer says, look, I&#8217;m running a website on your servers. I need to now be in compliance with the accessibility requirements in my country, or I need to do certain things. Then there&#8217;s the answer. Let&#8217;s use WP Rocket for performance. Here&#8217;s a partnership that we have with them, right? And that&#8217;s where the plugin company can come in and help the host.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Beyond that, obviously joint co-marketing will also help the hoster. And obviously if you talk like Ionos, GoDaddy or Newfold, I mean they&#8217;re massive, like they have millions of customers. So probably what a plugin company can bring to help them in co-marketing is not going to make a huge impact. There&#8217;s hundreds of hosters with hundred thousands of customers. For them working with one of those plugin companies can still be very interesting in doing like joint co-marketing, and getting the word out.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:32] <strong>Nathan Wrigley:</strong> That&#8217;s interesting. In the back of my head, when we were talking until just now, for some reason I was thinking about all the big hosts. You know, the ones that you&#8217;ve all heard of with the millions of customers. But of course that&#8217;s not the case, is it? There are thousands of smaller hosts.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:47] <strong>Martin Schmidt:</strong> Yes.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:22:48] <strong>Nathan Wrigley:</strong> Who may be more amenable to this kind of thing because, well, Idon&#8217;t know, they just don&#8217;t have that sort of scale that they need to worry about. And, you know, they&#8217;re looking for opportunities because they themselves are looking to grow in different ways that perhaps the other big hosts don&#8217;t have to think about quite so much.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Okay. So that&#8217;s interesting. So, you know, if it doesn&#8217;t fit one hosting company and you get a silent wall from all the big ones, that doesn&#8217;t mean you&#8217;re out of the game. It may be that the smaller hosts with different staff, and a different approach, and different geography and things like that, they may be more amenable to that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:23:21] <strong>Martin Schmidt:</strong> Yes, absolutely. And I will always tell my clients, I know that GoDaddy, Ionos and Newfold look very interesting because their publications, that they have millions of customers, but you don&#8217;t want to start with them. It&#8217;s going to take you three or four years to get a deal done if at all. If you start with them, I mean you&#8217;re going to give up frustrated halfway through probably.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So start with the smaller guys. They&#8217;re more approachable, right? They may be less busy. You mentioned that you get like 30 emails a week. That&#8217;s what the everyday of a product manager at an Ionos or GoDaddy looks like as well. They get pitches all the time. Getting some air time with them is nearly impossible.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Start with the smaller guys and they&#8217;re going to be a lot more open to discuss with you. And start some smaller partnerships. Work through the teething problems of partnerships with bigger companies, right? Build some track record. And once you&#8217;ve established a track record, you can work your way up, right? Every hoster has a competitor that&#8217;s bigger and one that&#8217;s smaller. Once the smaller competitor starts doing something, they will notice, and they will look like, why are these guys partnering with plugin company XYZ? Should we be doing the same? So you kind of like work your way up to the bigger guys and the bigger guys, right?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:34] <strong>Nathan Wrigley:</strong> Yeah.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:35] <strong>Martin Schmidt:</strong> Everyone is watching the other guys and watch what they do. So it&#8217;s, once you start working with some of them, the rest will start like, oh, this is interesting. If X, Y, Z worked with them, maybe we should too. That&#8217;s how you build the traction, but you need someone to start, right? And that&#8217;s probably not going to be the biggest guy.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:24:53] <strong>Nathan Wrigley:</strong> Yeah, and again, I hadn&#8217;t really thought about that, but yeah, the, sort of looking over your shoulder if you&#8217;re a hosting company, seeing with perhaps jealous eyes, oh look, they&#8217;re getting loads of attention out there on social media because they&#8217;ve formed this relationship. And their emails are going out, and people are making comments on their tweets and their blog posts and things like that. Oh, we should definitely get a bit of that. Okay. That&#8217;s, really interesting.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So if somebody approaches you, then let&#8217;s say they&#8217;ve got a plugin. Let&#8217;s just assume that it&#8217;s a plugin that is useful and that a hosting company would be interested in it, if they had everything wrapped up correctly. What would be some wisdom that you would drop in terms of how to wrap it up? Like, how prepared do you need to be? What are the kind of things that you expect plugin developers to have ready, so that on day one, when you do your first outreach to the first hosting company, you feel confident that, okay, I&#8217;ve got a good client here, we&#8217;ve got a good chance. What are the bits and pieces that you need to have them have done?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:25:50] <strong>Martin Schmidt:</strong> I think on the technical side, I mean they will need to have some sort of like provisioning enabled. The host would probably want to sell the plugin themselves within their billing engine, and their system. So they will need some sort of provisioning to your system to say look, someone bought a licence and this licence needs to be valid and stuff like that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So, this integration and that usually, I mean, if you don&#8217;t have that, it probably takes you a few months to implement that. So that&#8217;s something like, I would really start first and built these kind of things.</p>\n\n\n\n<p class=\"wp-block-paragraph\">The other stuff that I think the plugin company should have ready is, what&#8217;s your proposition to the web host? And what&#8217;s the proposition of your product to the web host customers? I always tell my clients like, don&#8217;t make the other guys think. Tell them. Show them that you thought about it. Coming back to our earlier point about people being unprepared, don&#8217;t be that unprepared person. Like once you get some air time with these guys, tell them what your product is. Tell them what your product, or your company can do for the web host. But also tell them how they should be using your product and marketed to their customers.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:56] <strong>Nathan Wrigley:</strong> Kind of spoonfeed them basically.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:58] <strong>Martin Schmidt:</strong> Yes.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:26:59] <strong>Nathan Wrigley:</strong> Have everything so that they can lift it and just walk off with it and, okay, we&#8217;ll do that then.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:27:03] <strong>Martin Schmidt:</strong> Yes. It might feel like spoonfeeding and like, why do I need to do your job? But I mean, in the end, put yourself in the shoes of that product manager, and tell them, look, if I was you, I would be selling my product this and this way.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Some of the worst product pitches I had. Companies came to me. Told me look, this is our product. You&#8217;re going to make millions with it. And then I was like, okay, that&#8217;s interesting. How do I sell it to my customer? And then the answer was like, I don&#8217;t know your customers. You need to know how to sell stuff to your customer. It&#8217;s like, that&#8217;s not how you land a deal, right?</p>\n\n\n\n<p class=\"wp-block-paragraph\">And one thing I like to do when I was pitching products. I looked at the website of the company I was pitching to. I mocked up their website with my product, and I put that in my presentation, and I told them, look sorry guys, we already hacked your website. Our product is already on your website. This is what it&#8217;s going to looks like. This is what it&#8217;s sold for, right? It shows them that you put some thought into that. That&#8217;s going to make you stand out.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Understand the work life of that product manager. They get those 30 emails like you, do. They decide to go on that meeting with you. You spend 30 minute pitching your product, and then you leave them with this big question mark. Like okay, this sounds interesting, but how the heck do I sell this to my customers?</p>\n\n\n\n<p class=\"wp-block-paragraph\">After your meeting then they have lunch, then there&#8217;s like an escalation, then there&#8217;s an all hands, then there&#8217;s the weekend. On the next Monday they will have almost forgotten about you. And if they think about you it&#8217;s, oh, I still have to figure out how to sell this. This is complicated. I don&#8217;t have time for this. I&#8217;m going to postpone it. And that&#8217;s not what you want to achieve.</p>\n\n\n\n<p class=\"wp-block-paragraph\">You want them to go out of that meeting and thinking, well this is an amazing product, solves a problem for my customers. And these partners, they think about me. They think about how I should be selling it. And maybe it&#8217;s not a hundred percent right. It&#8217;s not about getting it a hundred percent right.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:28:51] <strong>Nathan Wrigley:</strong> Right. They can adapt.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:28:52] <strong>Martin Schmidt:</strong> Yes. But giving them something to adapt is like a lot more than just don&#8217;t give them anything, right. And adapting is always easier than coming up with it yourself.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:29:01] <strong>Nathan Wrigley:</strong> So, the email that I typically get is basically a description of a product. It tells me what it&#8217;s called and then what it does. And often it&#8217;s a fairly technical description of a product. And, I imagine that if you are a marketer, you&#8217;re four lines into that email and your eyes have glazed over, and it&#8217;s like, okay great.</p>\n\n\n\n<p class=\"wp-block-paragraph\">But what you are describing is go the extra mile. Don&#8217;t just explain the product. Presumably, there&#8217;s a bit of that&#8217;s got to go on, but it&#8217;s also now explain to the person receiving that email how their company can use that. How they could market it. The way that could be marketed. The sort of mockup landing page that you described just there. Go the extra mile, sit in their seat for a minute. Try to imagine what their busy life is like, have a bit of empathy, and imagine that they&#8217;ve only got an attention span of a few moments. It&#8217;s more that, than the here&#8217;s a product description. Now that you know what it is, please come and contact us, because that&#8217;s just not going to happen.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:29:59] <strong>Martin Schmidt:</strong> No, it&#8217;s not. I think it&#8217;s the same for us in private life. If you get emails about products that. I mean you just know yourself. You&#8217;re busy with so many things in between. Your kids coming home from school, and someone calling, your parents calling and all of that. You, just look at the email and if it doesn&#8217;t click immediately, it goes to the trash bin.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And it&#8217;s the same with these guys as well. Convincing people just in email is probably going to be difficult. You need to at least get them into the meeting. And I think that&#8217;s the one step before that. But once you have them in a meeting, spend that time wisely. It&#8217;s difficult enough to get them into the meeting. But if you have them in a meeting, don&#8217;t waste it with generic presentations.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Invest this little bit of effort, and mocking up that websites or just taking a bit of a look at who they&#8217;re selling to and adapting your message to that. It doesn&#8217;t take a ton of work. And it didn&#8217;t take a tonne of work four or five years ago. And now with AI it&#8217;s even less, it&#8217;s even less work, right? But if you want me to trust you as my partner to go forward and sell to my customers, that&#8217;s going to blame me for everything. I want to see that you invest a little bit of effort too.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:31:04] <strong>Nathan Wrigley:</strong> I think that&#8217;s right. Yeah. I think that&#8217;s a very human characteristic, isn&#8217;t it? I would like to see that you made an effort, if I&#8217;m going to make an effort. That&#8217;s just how the game goes, right? That&#8217;s just how it is. You know, if I get the impression that you just want to rock up, make loads of money, and do nothing, that&#8217;s never going to work really.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:31:25] <strong>Martin Schmidt:</strong> No.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:31:26] <strong>Nathan Wrigley:</strong> I mean there&#8217;s the occasional person that manages to pull that off, but on the whole, that&#8217;s not how human relationships flourish and work.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:31:33] <strong>Martin Schmidt:</strong> In the end, it&#8217;s about you want to build a partnership, right? And that&#8217;s not, I come to you and you give me loads of money. I don&#8217;t have a lot of friends like that. And I don&#8217;t think anyone else has a lots of friends like that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Usually it&#8217;s like you give and you receive, right? And sometimes one side invests a bit more, and the other side invests a bit more. But usually if only one side is giving and the other one is only taking, that&#8217;s a toxic relationship. And usually they tend to break. So why should business relationships work any differently?</p>\n\n\n\n<p class=\"wp-block-paragraph\">But it&#8217;s a funny conception that a lot of companies have is oh, I want to do partnerships. I just go out there and then they&#8217;re going to sell my product and I&#8217;m going to make lots of money, and I don&#8217;t need to do anything. That&#8217;s honestly what a lot of companies think.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And that&#8217;s the difficulty that a lot of partner managers have, right? They&#8217;re being sent out to get those partners, and then they&#8217;re expected to bring in just all the revenue without any additional investment. And that&#8217;s just not happening. Honest truth, nobody is out there waiting for you and for your product.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:32:32] <strong>Nathan Wrigley:</strong> Yeah. That is the brutal truth isn&#8217;t it? Do you subscribe to doing things in person? You know, so WordPress has got a real panoply of events, Meetups and WordCamps and there&#8217;s obviously other things that you mentioned, you know, Cloudfest and things like that. Do you find that tends to short circuit things?</p>\n\n\n\n<p class=\"wp-block-paragraph\">I guess there&#8217;s a bit of personality that comes into this as well. You know, some people are, seem to have all the characteristics for selling. They&#8217;re incredibly good at that kind of thing. Maybe they&#8217;re practised at it. Maybe they&#8217;re just, you know, born in that wonderful manner. Do you subscribe to that? Is that a part of this jigsaw puzzle as well? You know, show up, meet the people, shake the hands, go to the restaurants, do the schmoozing and all of that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:33:12] <strong>Martin Schmidt:</strong> Absolutely. You could do all the Zoom calls that you want, but I&#8217;ve experienced it firsthand. Like during COVID, we were talking to people for six months via video conference. Like one in person meeting in Munich. It felt like this moved us further than just the six months of constant video calls.</p>\n\n\n\n<p class=\"wp-block-paragraph\">You can meet people, and you can relate to them, and there can be some sympathy and stuff like that. And you might not have to meet ever, but it usually helps a lot to build that trust. To just meet the person face to face, shake a hand, maybe have a beer and have a laugh and stuff like that just helps a great deal.</p>\n\n\n\n<p class=\"wp-block-paragraph\">And I&#8217;ve seen partnerships without any face-to-face meeting, but usually I would definitely advise to see people in person. And some people are just difficult to get hold of. And then catching them at the Colosseum Bar at Cloudfest 10 o&#8217;clock at night really helps to suddenly be in touch with that person.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:34:07] <strong>Nathan Wrigley:</strong> There is something ever so human about that isn&#8217;t there? And I think we all on some level enjoy that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">So you found yourself in this product market space. Like I said, I know that this is a thing. So I would imagine that given a fair wind, you&#8217;ll be doing this for years to come.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Where do you find yourself online? Do you have a website where you&#8217;ve packaged up these products and services, you know, these partnership liaison services that you do? Where can people find you? Where do they go online to discover more about you?</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:34:37] <strong>Martin Schmidt:</strong> At the moment mostly active on LinkedIn. That&#8217;s where I meet a lot of the people. I also have a website, martinschmidt.co. And that&#8217;s where also people can reach out to me. The website has been a little bit neglected to be quite fair because I straight on, jumped into LinkedIn and started publishing on LinkedIn, because the audience is already there. And people are not searching for how do I build partnerships with web hosts? But they come to me via LinkedIn because they tend to read some of my posts, and that&#8217;s how I get to speak to people like yourself.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:35:07] <strong>Nathan Wrigley:</strong> Yeah. Well, that is exactly how it happened. It was LinkedIn and I think you&#8217;re right. I think having a website would be of great value, but at the same time, you know, given the proclivities of what you&#8217;re doing, LinkedIn seems to be very much the best place to do that.</p>\n\n\n\n<p class=\"wp-block-paragraph\">What I&#8217;ll do is I will put your bits and pieces into the show notes. So if dear listener, you head to wptavern.com you search for the episode with Martin Schmidt, that&#8217;s S-C-H-M-I-D-T, you&#8217;ll be able to find the links there. So hopefully you&#8217;ll be able to contact Martin via LinkedIn and what have you.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Really interesting topic and Martin, thank you for chatting to me about it today.</p>\n\n\n\n<p class=\"wp-block-paragraph\">[00:35:42] <strong>Martin Schmidt:</strong> Yes. Thanks for having me, Nathan. It was fantastic.</p>\n</div></details>\n\n\n\n<p class=\"wp-block-paragraph\">On the podcast today we have <a href=\"https://www.martinschmidt.co\">Martin Schmidt</a>.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Martin has been deeply involved in the WordPress and hosting industries since 2005, when he created his first WordPress travel blog while living in New Zealand. Over the years, he’s developed websites for small businesses, spent 13 years with IONOS in various management and strategy roles, and built partnerships at Wix and a German SaaS company. Most recently, Martin has focused on connecting WordPress plugin companies with web hosts, helping both sides unlock growth through smarter partnerships.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Today the conversation focused on the often-overlooked world of partnerships between plugin developers and hosting companies. Martin shares insights from his two decades of experience on why hosting providers are the perfect allies for WordPress product makers looking to grow, given their established relationships and marketing channels to large customer bases.</p>\n\n\n\n<p class=\"wp-block-paragraph\">We talk about the curious fact that many plugin builders put enormous effort into their products, but stumble when it comes to sales, marketing, and building the business relationships necessary for broader success.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Martin discusses what hosting companies are actually looking for in a partnership, the technical and marketing preparations plugin makers should have ready, and why empathy and preparation make all the difference when trying to connect with busy product managers.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you’re a developer, freelancer, or agency owner interested in taking your WordPress product to the next level, or if you want a candid look at how partnerships really work in the open source ecosystem, this episode is for you.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Useful links</h2>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://www.martinschmidt.co\">Martin&#8217;s website</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://www.ionos.com\">IONOS</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://hosting.com\">Hosting.com</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://wp-rocket.me\">WP Rocket</a></p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://www.linkedin.com/in/martinschm/\">Martin on LinkedIn</a></p>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Wed, 04 Nov 2026 13:00:00 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:14:\"Nathan Wrigley\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:17;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:61:\"Open Channels FM: The Human Hurdle in Automated Cybersecurity\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2566451\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:68:\"https://openchannels.fm/the-human-hurdle-in-automated-cybersecurity/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:371:\"As artificial intelligence takes a more prominent role in cybersecurity, organizations face a growing challenge: the speed at which AI can discover vulnerabilities far outpaces human capacity to address them. Some news here on our podcast shines a light on how automation is transforming not just how vulnerabilities are identified, but how trust, autonomy, and [&#8230;]\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Wed, 04 Nov 2026 10:34:00 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:16:\"Open Channels FM\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:18;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:40:\"WordPress.org blog: WordPress 7.2 Beta 4\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:35:\"https://wordpress.org/news/?p=21907\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:56:\"https://wordpress.org/news/2026/11/wordpress-7-2-beta-4/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:11:\"description\";a:1:{i:0;a:5:{s:4:\"data\";s:7749:\"<p class=\"wp-block-paragraph\">WordPress 7.2 Beta 4 is ready for download and testing!</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>This beta release is intended for testing and development</strong> only. Please do not install, run, or test this version of WordPress on production or mission-critical websites. Instead, use a test environment or local site to explore the new features.</p>\n\n\n\n<h3 class=\"wp-block-heading\">Wait, what happened to 7.2 Beta 3???</h3>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://wordpress.org/news/2026/10/wordpress-7-1-4/\">WordPress 7.1.4 was released on October 28</a> which included WordPress 7.2 Beta 3.</p>\n\n\n\n<h2 class=\"wp-block-heading\">How to Test WordPress 7.2 Beta 4</h2>\n\n\n\n<p class=\"wp-block-paragraph\">You can test WordPress 7.2 Beta 4 in any of the following ways:</p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong>WordPress Beta Tester Plugin</strong></td><td>Install and activate the <a href=\"https://wordpress.org/plugins/wordpress-beta-tester/\" rel=\"noreferrer noopener\" target=\"_blank\">WordPress Beta Tester</a> plugin on a WordPress install. Select the “Bleeding edge” channel and “Beta/RC Only” stream.</td></tr><tr><td><strong>Direct Download</strong></td><td>Download the <a href=\"https://wordpress.org/wordpress-7.2-beta4.zip\">Beta 4 version (zip)</a> and install it on a WordPress website.</td></tr><tr><td><strong>Command Line (WP-CLI)</strong></td><td>Use this <a href=\"https://make.wordpress.org/cli/\" rel=\"noreferrer noopener\" target=\"_blank\">WP-CLI</a> command: <br /><code>wp core update --version=7.2-beta4</code></td></tr><tr><td><strong>WordPress Playground</strong></td><td>Use a <a href=\"https://playground.wordpress.net/release\" rel=\"noopener\" target=\"_blank\">7.2 Beta 4 WordPress Playground instance</a> to test the software directly in your browser. No setup required-just click and go!</td></tr></tbody></table></figure>\n\n\n\n<p class=\"wp-block-paragraph\">The scheduled final release date for WordPress 7.2 is <strong><strong>December 8, 2026</strong></strong>. The full <a href=\"https://make.wordpress.org/core/2026/10/06/wordpress-7-2-release-party-schedule/\">release schedule can be found here</a>. Your help testing Beta and RC versions is vital to making this release as stable and powerful as possible. Thank you to everyone who contributes by testing!</p>\n\n\n\n<h2 class=\"wp-block-heading\">What&#8217;s in WordPress 7.2 Beta 4?</h2>\n\n\n\n<p class=\"wp-block-paragraph\">For technical details on the issues addressed since Beta 2, see the following links:</p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://core.trac.wordpress.org/query?status=closed&amp;changetime=10%2F27%2F2026..11%2F03%2F2026&amp;milestone=7.2&amp;group=component&amp;col=id&amp;col=milestone&amp;col=owner&amp;col=type&amp;col=priority&amp;order=id\">Closed 7.2 WordPress Core Trac tickets</a> since October 27, 2026</li>\n\n\n\n<li><a href=\"https://github.com/WordPress/gutenberg/commits/wp/7.2?since=2026-10-27&amp;until=2026-11-03\">7.2 Gutenberg commits</a> since October 27, 2026</li>\n</ul>\n\n\n\n<h3 class=\"wp-block-heading\">Continued Improvements to WordPress 7.2</h3>\n\n\n\n<p class=\"wp-block-paragraph\">WordPress 7.2 Beta 4 continues refining the upcoming release with improvements to accessibility, editor reliability, and developer APIs, alongside additional bug fixes and compatibility updates.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Recent work includes improved keyboard focus visibility in Windows High Contrast mode, refinements to administration interfaces, and fixes for right-to-left block alignment and custom block spacing.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Developers will also benefit from continued improvements to the Abilities API, DataViews extensibility, and REST API behavior. Additional fixes strengthen revision handling, input validation, and compatibility across supported environments.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Learn more:</strong> <a href=\"https://core.trac.wordpress.org/ticket/45910\">Trac #45910</a>, <a href=\"https://core.trac.wordpress.org/ticket/66382\">Trac #66382</a>, <a href=\"https://core.trac.wordpress.org/ticket/66427\">Trac #66427</a>, <a href=\"https://core.trac.wordpress.org/ticket/66383\">Trac #66383</a>, <a href=\"https://core.trac.wordpress.org/ticket/66343\">Trac #66343</a>, <a href=\"https://core.trac.wordpress.org/ticket/66329\">Trac #66329</a></p>\n\n\n\n<h3 class=\"wp-block-heading\">Continued Improvements to Ipsum</h3>\n\n\n\n<p class=\"wp-block-paragraph\">The new default theme, Ipsum, continues to receive refinements ahead of WordPress 7.2&#8217;s final release. Recent updates improve accessibility with clearer keyboard focus indicators, more descriptive screen reader links, and better support for right-to-left languages. Additional improvements refine block patterns, touch target spacing, and color palette compatibility with other default themes.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Learn more:</strong> <a href=\"https://core.trac.wordpress.org/ticket/66352\">Trac #66352</a>, <a href=\"https://github.com/WordPress/wordpress-develop/pull/15113\">GitHub #15113</a></p>\n\n\n\n<h3 class=\"wp-block-heading\">Improved Translation Update Management</h3>\n\n\n\n<p class=\"wp-block-paragraph\">WordPress 7.2 makes managing translation updates easier by displaying individual available updates on the Updates screen. Administrators can now review and selectively install translation updates, bringing language management in line with the familiar plugin and theme update experience.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Learn more:</strong> <a href=\"https://core.trac.wordpress.org/ticket/42281\">Trac #42281</a>, <a href=\"https://github.com/WordPress/wordpress-develop/pull/11610\">GitHub #11610</a></p>\n\n\n\n<h2 class=\"wp-block-heading\">How important is your testing?</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Testing for issues is a critical part of developing any software, and it’s a meaningful way for anyone to contribute – whether or not you have experience. <a href=\"https://make.wordpress.org/test/2026/10/20/help-test-wordpress-7-2/\">Details on what to test in WordPress 7.2 are available here</a>.</p>\n\n\n\n<p class=\"wp-block-paragraph\">If you encounter an issue, please share it in the <a href=\"https://wordpress.org/support/forum/alphabeta/\" rel=\"noopener\" target=\"_blank\">Alpha/Beta area</a> of the support forums. If you are comfortable submitting a reproducible bug report, you can do so <a href=\"https://core.trac.wordpress.org/newticket\" rel=\"noopener\" target=\"_blank\">via WordPress Trac</a>. You can also check your issue against this list of <a href=\"https://core.trac.wordpress.org/tickets/major\" rel=\"noopener\" target=\"_blank\">known bugs</a>.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Curious about testing releases in general and how to get started? Follow along with the <a href=\"https://make.wordpress.org/test/\">testing initiatives in Make Core</a> and join the <a href=\"https://wordpress.slack.com/messages/core-test/\">#core-test channel</a> on <a href=\"https://wordpress.slack.com/\">Making WordPress Slack</a>.</p>\n\n\n\n<h2 class=\"wp-block-heading\">A Beta 4 haiku</h2>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Where did Beta Three go?<br />A surprise along the way<br />Four arrives on cue</em>.</p>\n\n\n\n<p class=\"has-text-align-right wp-block-paragraph\"><em>Props to <a class=\"mention\" href=\"https://profiles.wordpress.org/audrasjb/\"><span class=\"mentions-prefix\">@</span>audrasjb</a>, <a class=\"mention\" href=\"https://profiles.wordpress.org/courane01/\"><span class=\"mentions-prefix\">@</span>courane01</a>, <a class=\"mention\" href=\"https://profiles.wordpress.org/huzaifaalmesbah/\"><span class=\"mentions-prefix\">@</span>huzaifaalmesbah</a> for pre-publish review</em>.</p>\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:7:\"pubDate\";a:1:{i:0;a:5:{s:4:\"data\";s:31:\"Tue, 03 Nov 2026 15:45:29 +0000\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}s:32:\"http://purl.org/dc/elements/1.1/\";a:1:{s:7:\"creator\";a:1:{i:0;a:5:{s:4:\"data\";s:14:\"David Baumwald\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}}}}i:19;a:6:{s:4:\"data\";s:21:\"\n	\n	\n	\n	\n	\n	\n	\n	\n	\n	\n\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";s:5:\"child\";a:2:{s:0:\"\";a:5:{s:5:\"title\";a:1:{i:0;a:5:{s:4:\"data\";s:114:\"Open Channels FM: Drupal Commerce Exploits, Synology Ransomware, DeepSeek Coding Tools, and France’s Tax on Data\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"guid\";a:1:{i:0;a:5:{s:4:\"data\";s:34:\"https://openchannels.fm/?p=2566476\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explicit\";b:0;s:8:\"xml_lang\";s:0:\"\";}}s:4:\"link\";a:1:{i:0;a:5:{s:4:\"data\";s:115:\"https://openchannels.fm/drupal-commerce-exploits-synology-ransomware-deepseek-coding-tools-and-frances-tax-on-data/\";s:7:\"attribs\";a:0:{}s:8:\"xml_base\";s:0:\"\";s:17:\"xml_base_explic